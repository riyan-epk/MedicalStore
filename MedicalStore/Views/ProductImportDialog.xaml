<Window x:Class="MedicalStore.Views.ProductImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Product Import" Width="560" SizeToContent="Height" MaxHeight="650"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgPrimaryBrush}">
    <Border Background="White" CornerRadius="14" Margin="14" Padding="24,20">
        <StackPanel>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="📦" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="Bulk Product Import" FontSize="18" FontWeight="Bold"
                               Foreground="#1A237E"/>
                    <TextBlock Text="Import products from an Excel file (.xlsx)" FontSize="11"
                               Foreground="#546E7A" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Height="1" Background="#E3E8EF" Margin="0,10,0,14"/>

            <!-- Step 1: Download Template -->
            <TextBlock Text="Step 1: Get the Template" FontSize="13" FontWeight="SemiBold"
                       Foreground="#37474F" Margin="0,0,0,8"/>
            <Border CornerRadius="10" Padding="14,10" Background="#E8F5E9" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Download the sample Excel template" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#2E7D32"/>
                        <TextBlock Text="Fill in your products using the provided columns and format."
                                   FontSize="10" Foreground="#558B2F" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Download Template" Style="{StaticResource SuccessButton}"
                            Height="34" Padding="14,0" FontSize="12" Margin="10,0,0,0"
                            Click="DownloadTemplate_Click"/>
                </Grid>
            </Border>

            <!-- Step 2: Upload File -->
            <TextBlock Text="Step 2: Upload Your Excel File" FontSize="13" FontWeight="SemiBold"
                       Foreground="#37474F" Margin="0,0,0,8"/>
            <Border CornerRadius="10" Padding="14,10" Background="#E3F2FD" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="lblSelectedFile" Text="No file selected" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#1565C0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Browse File" Style="{StaticResource PrimaryButton}"
                            Height="34" Padding="14,0" FontSize="12" Margin="10,0,0,0"
                            Click="BrowseFile_Click"/>
                </Grid>
            </Border>

            <!-- Progress -->
            <StackPanel x:Name="panelProgress" Visibility="Collapsed" Margin="0,8,0,0">
                <TextBlock x:Name="lblProgress" Text="Processing..." FontSize="12" FontWeight="SemiBold"
                           Foreground="#37474F" Margin="0,0,0,6"/>
                <ProgressBar x:Name="progressBar" Height="20" Minimum="0" Maximum="100" Value="0"
                             Foreground="#1A73E8" Background="#E3E8EF"/>
                <TextBlock x:Name="lblProgressDetail" Text="" FontSize="10" Foreground="#78909C"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Results -->
            <Border x:Name="panelResults" Visibility="Collapsed" CornerRadius="10" Padding="14,10"
                    Background="#F3E5F5" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Import Results" FontSize="13" FontWeight="Bold" Foreground="#6A1B9A"
                               Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Total Rows:" FontSize="12" Foreground="#37474F"/>
                        <TextBlock x:Name="lblTotalRows" Text="0" HorizontalAlignment="Right" FontSize="12"
                                   FontWeight="Bold" Foreground="#37474F"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Successfully Imported:" FontSize="12" Foreground="#2E7D32"/>
                        <TextBlock x:Name="lblSuccess" Text="0" HorizontalAlignment="Right" FontSize="12"
                                   FontWeight="Bold" Foreground="#2E7D32"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Skipped (duplicates):" FontSize="12" Foreground="#F57C00"/>
                        <TextBlock x:Name="lblSkipped" Text="0" HorizontalAlignment="Right" FontSize="12"
                                   FontWeight="Bold" Foreground="#F57C00"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Errors:" FontSize="12" Foreground="#D32F2F"/>
                        <TextBlock x:Name="lblErrors" Text="0" HorizontalAlignment="Right" FontSize="12"
                                   FontWeight="Bold" Foreground="#D32F2F"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Error/Warning Log -->
            <ScrollViewer x:Name="scrollLog" Visibility="Collapsed" MaxHeight="120" Margin="0,8,0,0"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="lblLog" FontSize="10" Foreground="#78909C" TextWrapping="Wrap"/>
            </ScrollViewer>

            <!-- Buttons -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Close" Style="{StaticResource DangerButton}"
                        Click="Close_Click" MinHeight="40" FontSize="13"/>
                <Button Grid.Column="2" x:Name="btnImport" Content="Start Import" Style="{StaticResource SuccessButton}"
                        Click="StartImport_Click" MinHeight="40" FontSize="13" IsEnabled="False"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>
