<Window x:Class="MedicalStore.Views.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product Details" 
        Width="1050" Height="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" MouseLeftButtonDown="Window_MouseDown">
    
    <Border Background="White" CornerRadius="12" Margin="16">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.1"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Fixed Header -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="12,12,0,0" Padding="20,16" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0">
                <Grid>
                    <TextBlock x:Name="lblTitle" Text="Add Product" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Button Content="X" HorizontalAlignment="Right" VerticalAlignment="Center" Width="32" Height="32" Style="{StaticResource DangerButton}" Click="Cancel_Click" ToolTip="Close"/>
                </Grid>
            </Border>

            <!-- Scrollable Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Column 1 -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Product Name *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtName" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                            <TextBlock Text="Company" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtCompany" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                            <TextBlock Text="Barcode" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtBarcode" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                            <TextBlock Text="Purchase Price" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtPurchasePrice" Style="{StaticResource ModernTextBox}" PreviewTextInput="NumberValidation" Margin="0,0,0,16"/>
                            
                            <TextBlock Text="Manuf. Date" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <DatePicker x:Name="dpManufDate" Height="38" FontSize="14" Margin="0,0,0,16"/>
                        </StackPanel>

                        <!-- Column 2 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Category" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,16">
                                <Button DockPanel.Dock="Right" Content="X" Width="38" Height="38" BorderBrush="{StaticResource DangerBrush}" Foreground="{StaticResource DangerBrush}" Background="White" Margin="4,0,0,0" Click="DeleteCategory_Click" ToolTip="Delete Category"/>
                                <Button DockPanel.Dock="Right" Content="+" Width="38" Height="38" BorderBrush="{StaticResource PrimaryBrush}" Foreground="{StaticResource PrimaryBrush}" Background="White" Margin="4,0,0,0" Click="AddCategory_Click" ToolTip="Add Category"/>
                                <ComboBox x:Name="cmbCategory" DisplayMemberPath="Name" SelectedValuePath="Id" Height="38" FontSize="14" Padding="8,6"/>
                            </DockPanel>

                            <TextBlock Text="Batch No" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtBatchNo" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                            <TextBlock Text="Min Stock Level (units)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtMinStock" Style="{StaticResource ModernTextBox}" Text="10" PreviewTextInput="NumberValidation" Margin="0,0,0,16"/>

                            <TextBlock Text="Sale Price" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtSalePrice" Style="{StaticResource ModernTextBox}" PreviewTextInput="NumberValidation" Margin="0,0,0,16"/>
                            
                            <TextBlock Text="Expiry Date" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <DatePicker x:Name="dpExpiryDate" Height="38" FontSize="14" Margin="0,0,0,16"/>
                        </StackPanel>

                        <!-- Column 3 -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Supplier" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,16">
                                <Button DockPanel.Dock="Right" Content="+" Width="38" Height="38" BorderBrush="{StaticResource PrimaryBrush}" Foreground="{StaticResource PrimaryBrush}" Background="White" Margin="4,0,0,0" Click="AddSupplier_Click" ToolTip="Add Supplier"/>
                                <ComboBox x:Name="cmbSupplier" DisplayMemberPath="Name" SelectedValuePath="Id" Height="38" FontSize="14" Padding="8,6"/>
                            </DockPanel>

                            <TextBlock Text="Quantity (units)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtQuantity" Style="{StaticResource ModernTextBox}" PreviewTextInput="NumberValidation" Margin="0,0,0,16"/>
                        </StackPanel>
                    </Grid>

                    <!-- Pack-Unit Selling Section -->
                    <Border x:Name="borderPackUnit" Margin="0,16,0,0"
                            Background="#F3F6FF" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Pack / Unit Settings" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="No. of Packs" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtNoOfPacks" Style="{StaticResource ModernTextBox}"
                                             Text="" PreviewTextInput="NumberValidation"
                                             TextChanged="PackPricing_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Units Per Pack" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtUnitsPerPack" Style="{StaticResource ModernTextBox}"
                                             Text="1" PreviewTextInput="NumberValidation"
                                             TextChanged="PackPricing_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Pack Price (Rs)" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtPackPrice" Style="{StaticResource ModernTextBox}"
                                             PreviewTextInput="NumberValidation"
                                             TextChanged="PackPricing_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Unit Price (auto)" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtUnitPriceDisplay" Style="{StaticResource ModernTextBox}"
                                             IsReadOnly="True" Background="#eef2ff"
                                             ToolTip="Auto-calculated: Pack Price Units Per Pack"/>
                                </StackPanel>
                            </Grid>
                            <!-- Stock display -->
                            <TextBlock x:Name="lblStockDisplay" Text="" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Fixed Footer -->
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,12,12" Padding="20,16" BorderThickness="0,1,0,0" BorderBrush="#E2E8F0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource DangerButton}" Click="Cancel_Click" Margin="0,0,12,0" Width="100"/>
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="Save_Click" Width="100"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>



