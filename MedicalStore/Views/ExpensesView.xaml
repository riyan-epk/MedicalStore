<Page x:Class="MedicalStore.Views.ExpensesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Expenses" Background="{StaticResource BgPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,14,20,10">
            <StackPanel>
                <TextBlock Text="Expenses" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Manage store operational expenses" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="20,0,20,14">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.06"/>
            </Border.Effect>
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Margin="0,0,16,10">
                    <TextBlock Text="Expense Name" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="txtName" Style="{StaticResource ModernComboBox}" Width="200" IsEditable="True" ToolTip="e.g. Electricity Bill">
                        <ComboBoxItem Content="Electricity Bill"/>
                        <ComboBoxItem Content="Water Bill"/>
                        <ComboBoxItem Content="Internet Bill"/>
                        <ComboBoxItem Content="Rent"/>
                        <ComboBoxItem Content="Staff Salary"/>
                        <ComboBoxItem Content="Store Maintenance"/>
                        <ComboBoxItem Content="Office Supplies"/>
                        <ComboBoxItem Content="Travel/Fuel"/>
                        <ComboBoxItem Content="Miscellaneous"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,16,10">
                    <TextBlock Text="Amount" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtAmount" Style="{StaticResource ModernTextBox}" Width="120" Tag="0.00" PreviewTextInput="NumberValidation"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,10">
                    <TextBlock Text="Date" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="dpDate" Width="140" FontSize="13" Height="38"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,10">
                    <TextBlock Text="Description" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtDescription" Style="{StaticResource ModernTextBox}" Width="250" Tag="Optional context"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <Button x:Name="btnSave" Content="Save Expense" Style="{StaticResource PrimaryButton}" Click="SaveExpense_Click" Height="38" Padding="16,0" Margin="0,0,8,0"/>
                    <Button x:Name="btnClear" Content="Clear" Style="{StaticResource AccentButton}" Click="Clear_Click" Height="38" Padding="16,0"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20" Margin="20,0,20,20">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.06"/>
            </Border.Effect>
            <DockPanel>
                <DataGrid x:Name="dgExpenses" Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="Auto"/>
                        <DataGridTextColumn Header="Expense Name" Binding="{Binding Name}" Width="Auto"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=Rs {0:N2}}" Width="Auto"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="1.5*"/>
                        <DataGridTemplateColumn Header="Actions" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Edit" Style="{StaticResource PrimaryButton}" Background="Transparent" Foreground="#1A73E8" Padding="8,4" Margin="0,0,8,0" Click="EditExpense_Click"/>
                                        <Button Content="Delete" Style="{StaticResource DangerButton}" Background="Transparent" Foreground="#E53935" Padding="8,4" Click="DeleteExpense_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Page>



