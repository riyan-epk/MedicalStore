<Page x:Class="MedicalStore.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      Title="Settings" Background="{StaticResource BgPrimaryBrush}">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Margin="0,0,0,40">
            
            <!-- Store Settings -->
            <Border Background="White" CornerRadius="14" Padding="32" Margin="0,0,0,24">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="10" Opacity="0.05"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Store Identity &amp; Contact" FontSize="20" FontWeight="Bold" Margin="0,0,0,24" Foreground="{StaticResource TextPrimaryBrush}"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Name -->
                        <StackPanel Grid.Column="0" Margin="0,0,0,20">
                            <TextBlock Text="Store Name" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtStoreName" Style="{StaticResource ModernTextBox}" Tag="Enter Medical Store Name" Height="42"/>
                        </StackPanel>
                        
                        <!-- Phone -->
                        <StackPanel Grid.Column="2" Margin="0,0,0,20">
                            <TextBlock Text="Phone Number" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtStorePhone" Style="{StaticResource ModernTextBox}" Tag="Enter contact number" Height="42"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Address -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Store Address" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtStoreAddress" Style="{StaticResource ModernTextBox}" Tag="Enter full store address" TextWrapping="Wrap" Height="70" VerticalContentAlignment="Top" AcceptsReturn="True"/>
                    </StackPanel>
                    
                    <!-- Logo -->
                    <Grid Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Store Logo" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtStoreLogo" Style="{StaticResource ModernTextBox}" Tag="Select image path..." IsReadOnly="True" Height="42"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Browse..." Style="{StaticResource PrimaryButton}" Click="BrowseLogo_Click" Width="110" Height="42" Margin="0,0,12,0"/>
                            <Button Content="Clear" Background="Transparent" Foreground="#E53935" BorderThickness="0" Click="ClearLogo_Click" Cursor="Hand" FontWeight="SemiBold" Padding="12,0"/>
                        </StackPanel>
                    </Grid>
                    
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,24"/>
                    
                    <Button Content="Save Store Details" Style="{StaticResource PrimaryButton}" Click="SaveStoreInfo_Click" HorizontalAlignment="Right" Padding="24,12" MinWidth="180"/>
                </StackPanel>
            </Border>
            
            <!-- Mid Row: POS Configuration & Backup side-by-side -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>
                
                <!-- POS Settings -->
                <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="32">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="10" Opacity="0.05"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="POS Configuration" FontSize="20" FontWeight="Bold" Margin="0,0,0,24" Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,0,20">
                                <TextBlock Text="Discount Type" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="cmbDiscountType" Style="{StaticResource ModernComboBox}" SelectedIndex="0" Height="42">
                                    <ComboBoxItem Content="Percentage"/>
                                    <ComboBoxItem Content="Value"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Margin="0,0,0,20">
                                <TextBlock Text="Default Tax (%)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <TextBox x:Name="txtTaxRate" Style="{StaticResource ModernTextBox}" Tag="e.g. 5.0" Height="42"/>
                            </StackPanel>
                        </Grid>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,0,28">
                                <TextBlock Text="Expiry Alert (Days)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <TextBox x:Name="txtExpiryDays" Style="{StaticResource ModernTextBox}" Tag="e.g. 90" Height="42"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,0,28">
                                <CheckBox x:Name="chkTwoDecimals" Content="Two Decimal Places" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,4"/>
                                <TextBlock Text="Enable precise fractional amounts." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="18,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,24"/>
                        <Button Content="Save POS Settings" Style="{StaticResource PrimaryButton}" Click="SavePosSettings_Click" HorizontalAlignment="Right" Padding="24,12" MinWidth="180"/>
                    </StackPanel>
                </Border>
                
                <!-- System Management / Database Backup -->
                <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="32" VerticalAlignment="Stretch">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="10" Opacity="0.05"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="System Management" FontSize="20" FontWeight="Bold" Margin="0,0,0,24" Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <Border Background="#EEF2FF" CornerRadius="8" Padding="16" Margin="0,0,0,24">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="DatabaseCheck" Width="28" Height="28" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Database Vault" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Protect your core data" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <Button Content="Backup Now" Style="{StaticResource SuccessButton}" Click="Backup_Click" Height="46" Margin="0,0,0,16"/>
                        <Button Content="Restore Data" Style="{StaticResource DangerButton}" Click="Restore_Click" Height="46" Margin="0,0,0,16"/>
                        <Button Content="View Audit Log" Style="{StaticResource PrimaryButton}" Click="ViewAuditLog_Click" Height="46"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- About Section -->
            <Border Background="White" CornerRadius="14" Padding="32">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="10" Opacity="0.05"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="About &amp; Developer" FontSize="20" FontWeight="Bold" Margin="0,0,0,24" Foreground="{StaticResource TextPrimaryBrush}"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- System Info -->
                        <Border Grid.Column="0" Background="{StaticResource PrimaryLightBrush}" CornerRadius="12" Padding="28" Margin="0,0,24,0" VerticalAlignment="Stretch" MinWidth="260">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="ApplicationCog" Width="48" Height="48" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                                <TextBlock Text="MedicalStore Pro 1.0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Complete Pharmacy System" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                <TextBlock Text=".NET 8 + SQLite Engine" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,20,0,0" HorizontalAlignment="Center" Opacity="0.7"/>
                            </StackPanel>
                        </Border>

                        <!-- Developer Profile -->
                        <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="28">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Background="{StaticResource BgSidebarBrush}" CornerRadius="32" Width="64" Height="64" Margin="0,0,20,0">
                                        <TextBlock Text="R" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Riyan" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Principal Software Engineer" FontSize="14" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <TextBlock Text="&quot;Building efficient and user-friendly store management solutions that empower your business.&quot;" 
                                           FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" 
                                           TextWrapping="Wrap" FontStyle="Italic" Margin="0,0,0,24" LineHeight="22"/>
                                           
                                <StackPanel Orientation="Horizontal">
                                    <!-- Phone Badge -->
                                    <Border Background="#E8F5E9" CornerRadius="8" Padding="14,10" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="PhoneCheck" Width="16" Height="16" Foreground="#2E7D32" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="03098484389" FontSize="14" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Dev Badge -->
                                    <Border Background="#E3F2FD" CornerRadius="8" Padding="14,10">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="CodeBraces" Width="16" Height="16" Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="Full-Stack Engineering" FontSize="14" FontWeight="Bold" Foreground="#1565C0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
