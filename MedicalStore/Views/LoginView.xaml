<Window x:Class="MedicalStore.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="MedicalStore Pro - Login" 
        Height="550" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="16" Background="White">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="2" BlurRadius="20" Opacity="0.2"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header with gradient -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" Height="160">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A73E8" Offset="0"/>
                        <GradientStop Color="#00BFA5" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <iconPacks:PackIconMaterial x:Name="iconStoreLogo" Kind="MedicalBag" Width="48" Height="48" Foreground="White"/>
                        <Image x:Name="imgStoreLogo" Width="48" Height="48" Visibility="Collapsed" Stretch="Uniform"/>
                    </StackPanel>
                    <TextBlock x:Name="lblStoreName" Text="MedicalStore Pro" FontSize="26" FontWeight="Bold" 
                               Foreground="White" HorizontalAlignment="Center"/>
                  
                </StackPanel>
            </Border>

            <!-- Close button -->
            <Button Grid.Row="0" Content="X" 
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,12,16,0" FontSize="16" Foreground="White"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Click="CloseButton_Click" Width="30" Height="30"/>

            <!-- Login Form -->
            <StackPanel Grid.Row="1" Margin="40,0,40,0" VerticalAlignment="Center" Height="277">

                <TextBlock Text="Sign In" FontSize="22" FontWeight="Bold" 
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24"/>

                <!-- Username -->
                <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" 
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="txtUsername" Style="{StaticResource ModernTextBox}" 
                         Margin="0,0,0,16" KeyDown="Input_KeyDown"/>

                <!-- Password -->
                <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" 
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="txtPassword" Style="{StaticResource ModernPasswordBox}" 
                             Margin="0,0,0,8" KeyDown="Input_KeyDown"/>

                <!-- Error message -->
                <TextBlock x:Name="lblError" Text="" FontSize="12" 
                           Foreground="{StaticResource DangerBrush}" Margin="0,0,0,16"
                           TextWrapping="Wrap" Visibility="Collapsed"/>

                <!-- Login Button -->
                <Button Content="Sign In" Style="{StaticResource PrimaryButton}" 
                        Click="LoginButton_Click" Height="44" FontSize="15" Margin="0,0,0,12"/>

                <!-- Trial / license status -->
                <Border x:Name="trialBox" CornerRadius="6" Padding="8,5" Background="#FFF3E0"
                        Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock x:Name="lblTrial" Text="" FontSize="11" FontWeight="SemiBold"
                               Foreground="#8A5A00" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>

                <!-- Footer / developer branding -->
                <TextBlock x:Name="lblBranding" Text="Developed by 💻 Riyan  •  0309 8480389"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Opacity="0.85"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>



