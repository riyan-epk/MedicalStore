<Window x:Class="MedicalStore.Views.ReceivePurchaseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receive Purchase Order" Height="500" Width="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgPrimaryBrush}">
    <Border Background="White" CornerRadius="12" Margin="16" Padding="24">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Receive Purchase Order" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Top" x:Name="lblInfo" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
            <TextBlock DockPanel.Dock="Top" Text="Set 'Receive Now' for each line (defaults to the full remaining quantity). Received goods are added to stock and to the supplier's payable."
                       FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancel" Style="{StaticResource DangerButton}" Click="Cancel_Click" Width="120" Height="42" Margin="0,0,12,0"/>
                <Button Content="Receive" Style="{StaticResource SuccessButton}" Click="Save_Click" Width="150" Height="42"/>
            </StackPanel>

            <DataGrid x:Name="dgItems" AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Ordered" Binding="{Binding Ordered}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Received" Binding="{Binding Received}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Remaining" Binding="{Binding Remaining}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Receive Now" Binding="{Binding ReceiveNow, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</Window>
