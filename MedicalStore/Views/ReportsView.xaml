<Page x:Class="MedicalStore.Views.ReportsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Reports" Background="{StaticResource BgPrimaryBrush}"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Border Grid.Row="0" Padding="20,14,20,10">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Reports" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Generate financial, inventory, and customer reports"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filter Bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="18,14" Margin="0,0,0,14">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="8" Opacity="0.08"/>
            </Border.Effect>
            <WrapPanel VerticalAlignment="Center">
                <!-- Date Filters -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,10">
                        <TextBlock Text="" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <DatePicker x:Name="dpFrom" Width="145" FontSize="13" Margin="0,0,16,0"/>
                        <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <DatePicker x:Name="dpTo"   Width="145" FontSize="13" Margin="0,0,20,0"/>
                    </StackPanel>

                    <!-- Quick range buttons -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,10">
                        <Button Content="Today"      Style="{StaticResource PrimaryButton}"  Margin="0,0,6,0"  Click="QuickToday_Click"  Height="32" Padding="12,0" FontSize="12"/>
                        <Button Content="This Week"  Style="{StaticResource AccentButton}"   Margin="0,0,6,0"  Click="QuickWeek_Click"   Height="32" Padding="12,0" FontSize="12"/>
                        <Button Content="This Month" Style="{StaticResource AccentButton}"   Margin="0,0,6,0"  Click="QuickMonth_Click"  Height="32" Padding="12,0" FontSize="12"/>
                        <Button Content="This Year"  Style="{StaticResource AccentButton}"   Margin="0,0,0,0"  Click="QuickYear_Click"   Height="32" Padding="12,0" FontSize="12"/>
                    </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                    <Button Content="Generate" Style="{StaticResource SuccessButton}" Click="Generate_Click"
                            Height="38" Padding="16,0" Margin="0,0,8,0" FontSize="13"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Status Banner -->
        <Border x:Name="bannerStatus" Grid.Row="1" Visibility="Collapsed"
                CornerRadius="10" Padding="16,10" Margin="0,-16,0,16" VerticalAlignment="Bottom"
                BorderThickness="1" Background="#E3F2FD" BorderBrush="#BBDEFB">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial x:Name="bannerIcon" Kind="Information" VerticalAlignment="Center" Width="18" Height="18" Margin="0,0,12,0"/>
                <TextBlock x:Name="txtBannerMsg" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Tab Reports -->
        <TabControl Grid.Row="2" x:Name="tabReports" FontSize="13">

            <!-- Sales Report -->
            <TabItem Header="Sales">
                <Border Background="White" CornerRadius="0,0,14,14" Padding="16">
                    <DockPanel>
                        <!-- Top Toolbar with Export Button -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,14" Background="#F8FAFC" Padding="12" CornerRadius="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Sales Report Actions:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,15,0"/>
                                <Button Content="Export CSV" Style="{StaticResource AccentButton}" Margin="0,0,10,0" Click="ExportSalesCsv_Click"/>
                                <Button Content="Download PDF" Style="{StaticResource AccentButton}" Click="DownloadSalesPdf_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- KPI Cards -->
                        <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,14">
                            <Border Background="{StaticResource Card1Gradient}" CornerRadius="10"
                                    Padding="16,12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Total Sales" FontSize="11" Foreground="#C8FFFFFF"/>
                                    <TextBlock x:Name="lblReportSales" Text="Rs 0"
                                               FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Card3Gradient}" CornerRadius="10"
                                    Padding="16,12" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="Total Discounts" FontSize="11" Foreground="#C8FFFFFF"/>
                                    <TextBlock x:Name="lblReportDiscounts" Text="Rs 0"
                                               FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Card6Gradient}" CornerRadius="10"
                                    Padding="16,12" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Transactions" FontSize="11" Foreground="#C8FFFFFF"/>
                                    <TextBlock x:Name="lblReportTransactions" Text="0"
                                               FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <DataGrid x:Name="dgSalesReport" Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Invoice"  Binding="{Binding InvoiceNo}" Width="Auto"/>
                                <DataGridTextColumn Header="Date"     Binding="{Binding Date, StringFormat=dd/MM/yyyy hh:mm tt}" Width="Auto"/>
                                <DataGridTextColumn Header="Customer" Binding="{Binding Customer.Name}" Width="Auto"/>
                                <DataGridTextColumn Header="Sub Total" Binding="{Binding SubTotal, StringFormat=Rs {0:N2}}" Width="Auto"/>
                                <DataGridTextColumn Header="Discount"  Binding="{Binding Discount,  StringFormat=Rs {0:N2}}" Width="Auto"/>
                                <DataGridTextColumn Header="Net"       Binding="{Binding NetAmount,  StringFormat=Rs {0:N2}}" Width="Auto"/>
                                <!-- Paid Green if fully paid -->
                                <DataGridTemplateColumn Header="Paid" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PaidAmount, StringFormat=Rs {0:N2}}"
                                                       FontWeight="SemiBold" HorizontalAlignment="Right" Margin="4,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#43A047"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DueAmount}" Value="0">
                                                                <Setter Property="Foreground" Value="#43A047"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Due Red if due > 0 -->
                                <DataGridTemplateColumn Header="Due" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock FontWeight="SemiBold" HorizontalAlignment="Right" Margin="4,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding DueAmount, StringFormat=Rs {0:N2}}"/>
                                                        <Setter Property="Foreground" Value="#E53935"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DueAmount}" Value="0">
                                                                <Setter Property="Text" Value="Clear"/>
                                                                <Setter Property="Foreground" Value="#43A047"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- Inventory Report -->
            <TabItem Header="Inventory">
                <Border Background="White" CornerRadius="0,0,14,14" Padding="16">
                    <DockPanel>
                        <!-- Top Toolbar with Export Button -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,14" Background="#F8FAFC" Padding="12" CornerRadius="10">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Export Inventory CSV" Style="{StaticResource AccentButton}" Margin="0,0,10,0" Click="ExportInventoryCsv_Click"/>
                                <Button Content="Export Low Stock" Style="{StaticResource AccentButton}" Margin="0,0,10,0" Click="ExportLowStockCsv_Click"/>
                                <Button Content="Download PDF" Style="{StaticResource AccentButton}" Margin="0,0,10,0" Click="DownloadInventoryPdf_Click"/>
                                <Button Style="{StaticResource AccentButton}" Background="Gray" Foreground="White" Click="AllStock_Click" Padding="15,4" Margin="30,0,5,0">
                                    <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="Refresh Stock Data"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="All Stock"      Style="{StaticResource SuccessButton}" Click="AllStock_Click"         Margin="0,0,10,0" Padding="16,8" FontSize="13"/>
                            <Button Content="Low Stock"      Style="{StaticResource AccentButton}"  Click="LowStockReport_Click"   Margin="0,0,10,0" Padding="16,8" FontSize="13"/>
                            <Button Content="Near Expiry"    Style="{StaticResource DangerButton}"  Click="NearExpiryReport_Click" Margin="0,0,10,0" Padding="16,8" FontSize="13"/>
                            <Button Content="Expired"         Style="{StaticResource DangerButton}"  Click="ExpiredReport_Click"    Padding="16,8" FontSize="13"/>
                        </StackPanel>
                        <DataGrid x:Name="dgInventoryReport" Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name"     Binding="{Binding Name}"               Width="Auto"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category.Name}"      Width="Auto"/>
                                <DataGridTextColumn Header="Company"  Binding="{Binding Company}"            Width="Auto"/>
                                <DataGridTextColumn Header="Stock"    Binding="{Binding Quantity}"           Width="Auto"/>
                                <DataGridTextColumn Header="Min"      Binding="{Binding MinStockLevel}"      Width="Auto"/>
                                <DataGridTextColumn Header="Buy"      Binding="{Binding PurchasePrice, StringFormat=Rs {0:N2}}" Width="Auto"/>
                                <DataGridTextColumn Header="Sell"     Binding="{Binding SalePrice,    StringFormat=Rs {0:N2}}" Width="Auto"/>
                                <DataGridTextColumn Header="Expiry"   Binding="{Binding ExpiryDate, StringFormat=dd/MM/yyyy}"  Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- Financial Report -->
            <TabItem Header="Financial">
                <Border Background="White" CornerRadius="0,0,14,14" Padding="20">
                    <StackPanel>
                        <!-- Top Toolbar with Export Button -->
                        <Border Margin="0,0,0,14" Background="#F8FAFC" Padding="12" CornerRadius="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Financial Report Actions:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,15,0"/>
                                <Button Content="Download PDF" Style="{StaticResource AccentButton}" Click="DownloadFinancialPdf_Click"/>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="3" Rows="2" Margin="0,0,0,18">
                            <Border Background="{StaticResource Card1Gradient}" CornerRadius="10" Padding="18" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Total Sales" FontSize="12" Foreground="#C8FFFFFF"/>
                                    <TextBlock x:Name="lblFinSales" Text="Rs 0" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Card3Gradient}" CornerRadius="10" Padding="18" Margin="4,0,4,8">
                                <StackPanel>
                                    <TextBlock Text="Purchases" FontSize="12" Foreground="#C8FFFFFF"/>
                                    <TextBlock x:Name="lblFinPurchases" Text="Rs 0" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Card4Gradient}" CornerRadius="10" Padding="18" Margin="8,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Refunds" FontSize="12" Foreground="#C8FFFFFF"/>
                                    <TextBlock x:Name="lblFinRefunds" Text="Rs 0" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Card5Gradient}" CornerRadius="10" Padding="18" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Discounts" FontSize="12" Foreground="#C8FFFFFF"/>
                                    <TextBlock x:Name="lblFinDiscounts" Text="Rs 0" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Card2Gradient}" CornerRadius="10" Padding="18" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="Expenses" FontSize="12" Foreground="#C8FFFFFF"/>
                                    <TextBlock x:Name="lblFinExpenses" Text="Rs 0" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Card6Gradient}" CornerRadius="10" Padding="18" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Net Profit" FontSize="12" Foreground="#C8FFFFFF"/>
                                    <TextBlock x:Name="lblFinProfit" Text="Rs 0" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Formula Hint -->
                        <Border Background="#F0F4FF" CornerRadius="8" Padding="14,10">
                            <TextBlock Text="Net Profit = Total Sales Profit - Total Expenses"
                                       FontSize="13" FontStyle="Italic" Foreground="#2A56C6" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Purchases Report -->
            <TabItem Header="Purchases">
                <Border Background="White" CornerRadius="0,0,14,14" Padding="16">
                    <DockPanel>
                        <!-- Top Toolbar with Export Button -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,14" Background="#F8FAFC" Padding="12" CornerRadius="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Purchases Report Actions:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,15,0"/>
                                <Button Content="Download PDF" Style="{StaticResource AccentButton}" Click="DownloadPurchasesPdf_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Purchases KPI Cards -->
                        <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,14">
                            <Border Background="{StaticResource Card5Gradient}" CornerRadius="10" Padding="14,12" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Total Purchase Value" FontSize="11" Foreground="#C8FFFFFF"/>
                                    <TextBlock x:Name="lblPurchTotal" Text="Rs 0" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Card1Gradient}" CornerRadius="10" Padding="14,12" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="Total Paid" FontSize="11" Foreground="#C8FFFFFF"/>
                                    <TextBlock x:Name="lblPurchPaid" Text="Rs 0" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Card4Gradient}" CornerRadius="10" Padding="14,12" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Outstanding Due" FontSize="11" Foreground="#C8FFFFFF"/>
                                    <TextBlock x:Name="lblPurchDue" Text="Rs 0" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <DataGrid x:Name="dgPurchaseReport" Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date"         Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="Auto"/>
                            <DataGridTextColumn Header="Supplier"     Binding="{Binding Supplier.Name}" Width="Auto"/>
                            <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, StringFormat=Rs {0:N2}}" Width="Auto"/>
                            <DataGridTextColumn Header="Paid"         Binding="{Binding PaidAmount, StringFormat=Rs {0:N2}}" Width="Auto"/>
                            <DataGridTextColumn Header="Due"          Binding="{Binding DueAmount, StringFormat=Rs {0:N2}}"  Width="Auto"/>
                            <DataGridTextColumn Header="Notes"        Binding="{Binding Notes}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- Customer Dues Report -->
            <TabItem Header="Customers">
                <Border Background="White" CornerRadius="0,0,14,14" Padding="16">
                    <DockPanel>
                        <!-- Top Toolbar with Detail Button -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,14" Background="#F8FAFC" Padding="12" CornerRadius="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Select Customer:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="cbCustomerDetail" Width="200" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="CbCustomerDetail_SelectionChanged"/>
                                <Button Content="Export CSV" Style="{StaticResource AccentButton}" Margin="15,0,5,0" Click="ExportCustomerCsv_Click"/>
                                <Button Content="Export Excel" Style="{StaticResource AccentButton}" Margin="5,0,5,0" Click="ExportCustomerExcel_Click"/>
                                <Button Content="Download PDF" Style="{StaticResource AccentButton}" Margin="5,0,5,0" Click="DownloadCustomerPdf_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Summary strip -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,14" CornerRadius="10" Padding="0">
                            <UniformGrid Columns="3">
                                <Border Background="#E8F5E9" CornerRadius="10" Padding="14,10" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Total Paid (Settled)" FontSize="12"
                                                   Foreground="#2E7D32" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="lblCustTotalPaid" Text="Rs 0"
                                                   FontSize="18" FontWeight="Bold" Foreground="#2E7D32" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFEBEE" CornerRadius="10" Padding="14,10" Margin="4,0">
                                    <StackPanel>
                                        <TextBlock Text="Total Outstanding Due" FontSize="12"
                                                   Foreground="#C62828" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="lblCustTotalDue" Text="Rs 0"
                                                   FontSize="18" FontWeight="Bold" Foreground="#C62828" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFF8E1" CornerRadius="10" Padding="14,10" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Total Advance/Credit" FontSize="12"
                                                   Foreground="#E65100" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="lblCustTotalCredit" Text="Rs 0"
                                                   FontSize="18" FontWeight="Bold" Foreground="#E65100" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Border>

                        <DataGrid x:Name="dgCustomerReport" Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date"   Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="Auto"/>
                                <DataGridTextColumn Header="Type"   Binding="{Binding Type}" Width="Auto"/>
                                <DataGridTextColumn Header="Ref"    Binding="{Binding Reference}" Width="Auto"/>
                                <DataGridTextColumn Header="Debit"  Binding="{Binding Debit, Converter={StaticResource CurrencyConverter}}" Width="Auto">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#C62828"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Credit" Binding="{Binding Credit, Converter={StaticResource CurrencyConverter}}" Width="Auto">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#2E7D32"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Products / Notes" Binding="{Binding Notes}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- Supplier Dues Report -->
            <TabItem Header="Suppliers">
                <Border Background="White" CornerRadius="0,0,14,14" Padding="16">
                    <DockPanel>
                        <!-- Top Toolbar with Detail Button -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,14" Background="#F8FAFC" Padding="12" CornerRadius="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Select Supplier:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="cbSupplierDetail" Width="200" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="CbSupplierDetail_SelectionChanged"/>
                                <Button Content="Export CSV" Style="{StaticResource AccentButton}" Margin="15,0,5,0" Click="ExportSupplierCsv_Click"/>
                                <Button Content="Export Excel" Style="{StaticResource AccentButton}" Margin="5,0,5,0" Click="ExportSupplierExcel_Click"/>
                                <Button Content="Download PDF" Style="{StaticResource AccentButton}" Margin="5,0,5,0" Click="DownloadSupplierPdf_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Summary strip -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,14" CornerRadius="10" Padding="0">
                            <UniformGrid Columns="3">
                                <Border Background="#E8F5E9" CornerRadius="10" Padding="14,10" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Total Paid (Settled)" FontSize="12"
                                                   Foreground="#2E7D32" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="lblSupTotalPaid" Text="Rs 0"
                                                   FontSize="18" FontWeight="Bold" Foreground="#2E7D32" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFEBEE" CornerRadius="10" Padding="14,10" Margin="4,0">
                                    <StackPanel>
                                        <TextBlock Text="Total Outstanding Due" FontSize="12"
                                                   Foreground="#C62828" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="lblSupTotalDue" Text="Rs 0"
                                                   FontSize="18" FontWeight="Bold" Foreground="#C62828" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FFF8E1" CornerRadius="10" Padding="14,10" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Total Advance/Credit" FontSize="12"
                                                   Foreground="#E65100" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="lblSupTotalCredit" Text="Rs 0"
                                                   FontSize="18" FontWeight="Bold" Foreground="#E65100" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Border>

                        <DataGrid x:Name="dgSupplierReport" Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date"   Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="Auto"/>
                                <DataGridTextColumn Header="Type"   Binding="{Binding Type}" Width="Auto"/>
                                <DataGridTextColumn Header="Ref"    Binding="{Binding Reference}" Width="Auto"/>
                                <DataGridTextColumn Header="Debit"  Binding="{Binding Debit,  Converter={StaticResource CurrencyConverter}}" Width="Auto">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#2E7D32"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Credit" Binding="{Binding Credit, Converter={StaticResource CurrencyConverter}}" Width="Auto">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#C62828"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Products / Notes" Binding="{Binding Notes}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- Returns Report -->
            <TabItem Header="Returns">
                <Border Background="White" CornerRadius="0,0,14,14" Padding="16">
                    <DockPanel>
                        <!-- Top Toolbar with Export Button -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,14" Background="#F8FAFC" Padding="12" CornerRadius="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Returns Report Actions:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,15,0"/>
                                <Button Content="Download PDF" Style="{StaticResource AccentButton}" Click="DownloadReturnsPdf_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Returns KPI Cards -->
                        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,14">
                            <Border Background="{StaticResource Card3Gradient}" CornerRadius="10" Padding="14,12" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Total Returns" FontSize="11" Foreground="#C8FFFFFF"/>
                                    <TextBlock x:Name="lblRetCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Card1Gradient}" CornerRadius="10" Padding="14,12" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="Returned Value" FontSize="11" Foreground="#C8FFFFFF"/>
                                    <TextBlock x:Name="lblRetTotal" Text="Rs 0" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Card6Gradient}" CornerRadius="10" Padding="14,12" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="Replaced Amount" FontSize="11" Foreground="#C8FFFFFF"/>
                                    <TextBlock x:Name="lblRetReplace" Text="Rs 0" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Card4Gradient}" CornerRadius="10" Padding="14,12" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Refunded Amount" FontSize="11" Foreground="#C8FFFFFF"/>
                                    <TextBlock x:Name="lblRetRefund" Text="Rs 0" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <DataGrid x:Name="dgReturnReport" Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date"     Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="Auto"/>
                                <DataGridTextColumn Header="Invoice"  Binding="{Binding Sale.InvoiceNo}"  Width="Auto"/>
                                <DataGridTextColumn Header="Customer" Binding="{Binding Customer.Name}"  Width="Auto"/>
                                <DataGridTemplateColumn Header="Type" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FFF3E0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ReturnType}" Value="Refund">
                                                                <Setter Property="Background" Value="#FFEBEE"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ReturnType}" Value="Replace">
                                                                <Setter Property="Background" Value="#E8F5E9"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ReturnType}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Returned Rs"   Binding="{Binding TotalAmount,  StringFormat={}{0:N2}}" Width="Auto"/>
                                <DataGridTextColumn Header="Replaced Rs"   Binding="{Binding ReplaceAmount,StringFormat={}{0:N2}}" Width="Auto"/>
                                <DataGridTextColumn Header="Refunded Rs"   Binding="{Binding RefundAmount, StringFormat={}{0:N2}}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Page>



