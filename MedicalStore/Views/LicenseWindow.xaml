<Window x:Class="MedicalStore.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Activate MedicalStore Pro"
        Height="560" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border CornerRadius="16" Background="White">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="2" BlurRadius="20" Opacity="0.2"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="16,16,0,0" Height="110">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A73E8" Offset="0"/>
                        <GradientStop Color="#00BFA5" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="KeyVariant" Width="34" Height="34" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Software Activation" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="34,20,34,0">
                <Border x:Name="statusBox" CornerRadius="8" Padding="12,10" Background="#FFF3E0" Margin="0,0,0,14">
                    <TextBlock x:Name="lblStatus" Text="" FontSize="13" FontWeight="SemiBold"
                               Foreground="#8A5A00" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>

                <!-- Machine ID: the customer sends this to the vendor to receive a key -->
                <TextBlock Text="Your Machine ID (send this to get a key)" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtMachineId" Grid.Column="0" IsReadOnly="True" FontSize="14" FontWeight="Bold"
                             Style="{StaticResource ModernTextBox}" Foreground="{StaticResource PrimaryBrush}"/>
                    <Button x:Name="btnCopyId" Grid.Column="1" Content="Copy" Style="{StaticResource AccentButton}"
                            Height="38" Width="70" Margin="8,0,0,0" Click="CopyId_Click"/>
                </Grid>

                <TextBlock Text="License Key" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="txtKey" Style="{StaticResource ModernTextBox}" FontSize="15"
                         Margin="0,0,0,6" CharacterCasing="Upper" Text="RYN-"/>
                <TextBlock x:Name="lblMsg" Text="" FontSize="12" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

                <Button x:Name="btnActivate" Content="Activate" Style="{StaticResource PrimaryButton}"
                        Height="42" FontSize="15" Click="Activate_Click" Margin="0,4,0,0"/>

                <Grid Margin="0,10,0,0">
                    <Button x:Name="btnContinue" Content="Continue Trial" Style="{StaticResource AccentButton}"
                            Height="36" HorizontalAlignment="Left" Width="150" Click="Continue_Click"/>
                    <Button x:Name="btnExit" Content="Exit" Style="{StaticResource DangerButton}"
                            Height="36" HorizontalAlignment="Right" Width="150" Click="Exit_Click"/>
                </Grid>

                <TextBlock x:Name="lblBranding" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,16,0,0" Opacity="0.85"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
