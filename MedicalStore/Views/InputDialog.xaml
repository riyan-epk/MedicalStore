<Window x:Class="MedicalStore.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" SizeToContent="Height" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BgPrimaryBrush}">
    <Border Background="White" CornerRadius="12" Margin="16" Padding="16">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.06"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="lblPrompt" Text="Enter value:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
            <TextBox x:Name="txtInput" Style="{StaticResource ModernTextBox}" Height="40" FontSize="16" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource DangerButton}" Click="Cancel_Click" Width="80" Height="38" Margin="0,0,10,0" IsCancel="True"/>
                <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="Ok_Click" Width="80" Height="38" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>



