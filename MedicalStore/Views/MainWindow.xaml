<Window x:Class="MedicalStore.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="MedicalStore Pro" 
        Height="750" Width="1200"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BgPrimaryBrush}">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}">
            <DockPanel>
                <!-- Logo Area -->
                <Border DockPanel.Dock="Top" Padding="20,20,20,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <iconPacks:PackIconMaterial x:Name="iconStoreLogo" Kind="Pill" Width="22" Height="22" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Image x:Name="imgStoreLogo" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed" Stretch="Uniform"/>
                            <TextBlock x:Name="lblStoreName" Text="MedicalStore Pro" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="lblUserInfo" Text="Administrator" FontSize="12"
                                   Foreground="{StaticResource TextSidebarBrush}" Margin="0,6,0,0"/>
                        <TextBlock x:Name="lblLicense" Text="" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#FFD54F" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                
                <Border DockPanel.Dock="Top" Height="1" Background="#334155" Margin="16,0"/>
                
                <!-- Developer branding (very bottom) -->
                <TextBlock DockPanel.Dock="Bottom" Text="Developed by Riyan  •  0309 8480389"
                           FontSize="10" Foreground="{StaticResource TextSidebarBrush}"
                           HorizontalAlignment="Center" Opacity="0.75" Margin="0,0,0,10"/>

                <!-- Logout at bottom -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource SidebarButton}" Click="Logout_Click" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Logout" Width="16" Height="16" Margin="0,0,12,0"/>
                        <TextBlock Text="Logout"/>
                    </StackPanel>
                </Button>
                <Border DockPanel.Dock="Bottom" Height="1" Background="#334155" Margin="16,0"/>
                
                <!-- Navigation -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel x:Name="navPanel">
                        <Button x:Name="btnDashboard" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="Dashboard">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="ViewDashboard" Width="16" Height="16" Margin="0,0,12,0"/><TextBlock Text="Dashboard"/></StackPanel>
                        </Button>
                        <Button x:Name="btnProducts" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="Products">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="Pill" Width="16" Height="16" Margin="0,0,12,0"/><TextBlock Text="Products"/></StackPanel>
                        </Button>
                        <Button x:Name="btnPOS" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="POS">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="Cart" Width="16" Height="16" Margin="0,0,12,0"/><TextBlock Text="POS Billing"/></StackPanel>
                        </Button>
                        <Button x:Name="btnSales" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="Sales">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="TrendingUp" Width="16" Height="16" Margin="0,0,12,0"/><TextBlock Text="Sales Tracking"/></StackPanel>
                        </Button>
                        <Button x:Name="btnPurchases" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="Purchases">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="PackageVariantClosed" Width="16" Height="16" Margin="0,0,12,0"/><TextBlock Text="Purchases"/></StackPanel>
                        </Button>
                        <Button x:Name="btnSuppliers" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="Suppliers">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="Truck" Width="16" Height="16" Margin="0,0,12,0"/><TextBlock Text="Suppliers"/></StackPanel>
                        </Button>
                        <Button x:Name="btnCustomers" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="Customers">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="AccountGroup" Width="16" Height="16" Margin="0,0,12,0"/><TextBlock Text="Customers"/></StackPanel>
                        </Button>
                        <Button x:Name="btnReturns" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="Returns">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="KeyboardReturn" Width="16" Height="16" Margin="0,0,12,0"/><TextBlock Text="Returns"/></StackPanel>
                        </Button>
                        <Button x:Name="btnManualRefund" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="ManualRefund">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="CashRefund" Width="16" Height="16" Margin="0,0,12,0"/><TextBlock Text="Manual Refund"/></StackPanel>
                        </Button>
                        <Button x:Name="btnReports" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="Reports">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="ChartBox" Width="16" Height="16" Margin="0,0,12,0"/><TextBlock Text="Reports"/></StackPanel>
                        </Button>
                        <Button x:Name="btnUsers" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="Users" x:FieldModifier="public">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="Account" Width="16" Height="16" Margin="0,0,12,0"/><TextBlock Text="Users"/></StackPanel>
                        </Button>
                        <Button x:Name="btnExpenses" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="Expenses">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="CashMultiple" Width="16" Height="16" Margin="0,0,12,0"/><TextBlock Text="Expenses"/></StackPanel>
                        </Button>
                        <Button x:Name="btnSettings" Style="{StaticResource SidebarButton}" Click="Nav_Click" Tag="Settings">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="Cog" Width="16" Height="16" Margin="0,0,12,0"/><TextBlock Text="Settings"/></StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        
        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="White" Padding="24,14" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <TextBlock x:Name="lblPageTitle" Text="Dashboard" 
                               FontSize="20" FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" 
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="lblDateTime" Text="" FontSize="12" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock x:Name="lblCurrentUser" Text="Admin" FontSize="13" 
                                   FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            
            <!-- Page Content -->
            <Border Grid.Row="1" Padding="24">
                <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
            </Border>
        </Grid>
    </Grid>
</Window>



