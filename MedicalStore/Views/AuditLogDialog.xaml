<Window x:Class="MedicalStore.Views.AuditLogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audit Log" Height="600" Width="820"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgPrimaryBrush}">
    <Border Background="White" CornerRadius="12" Margin="16" Padding="20">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Audit Log" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Top" Text="Recent money-affecting actions (payments, price changes, opening balances, purchase receive/cancel, supplier returns)."
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <Button DockPanel.Dock="Bottom" Content="Close" Style="{StaticResource PrimaryButton}" Click="Close_Click"
                    HorizontalAlignment="Right" Width="120" Height="40" Margin="0,12,0,0"/>
            <DataGrid x:Name="dgLog" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                    <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="110"/>
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="150"/>
                    <DataGridTextColumn Header="On" Binding="{Binding Entity}" Width="90"/>
                    <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</Window>
