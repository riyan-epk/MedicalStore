<Page x:Class="MedicalStore.Views.UsersView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Users" Background="{StaticResource BgPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Toolbar -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.06"/>
            </Border.Effect>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Add User" Style="{StaticResource PrimaryButton}" Click="AddUser_Click"/>
                <TextBlock Text="User Management" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        
        <!-- Users Grid -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.06"/>
            </Border.Effect>
            <DataGrid x:Name="dgUsers" Style="{StaticResource ModernDataGrid}" MouseDoubleClick="dgUsers_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="Auto"/>
                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="Auto"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="Auto"/>
                    <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="Auto"/>
                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>



