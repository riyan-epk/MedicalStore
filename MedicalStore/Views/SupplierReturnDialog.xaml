<Window x:Class="MedicalStore.Views.SupplierReturnDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Return Stock to Supplier" Height="520" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource BgPrimaryBrush}">
    <Border Background="White" CornerRadius="12" Margin="16" Padding="24">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Return Stock to Supplier" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBlock DockPanel.Dock="Top" x:Name="lblSupplierName" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>

            <TextBlock DockPanel.Dock="Top" Text="Enter a Return Qty for the items you are sending back. Value is credited at current cost and reduces the supplier's payable."
                       FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <TextBlock Text="Notes" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="txtNotes" Style="{StaticResource ModernTextBox}" Tag="Reason (damaged, expired, over-ordered)…"
                         Height="50" TextWrapping="Wrap" Margin="0,0,0,14"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancel" Style="{StaticResource DangerButton}" Click="Cancel_Click" MinHeight="42" FontSize="14"/>
                    <Button Grid.Column="2" Content="Process Return" Style="{StaticResource SuccessButton}" Click="Save_Click" MinHeight="42" FontSize="14"/>
                </Grid>
            </StackPanel>

            <DataGrid x:Name="dgItems" AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="0,0,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="In Stock" Binding="{Binding StockUnits}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Cost" Binding="{Binding Cost, StringFormat=Rs {0:N2}}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Return Qty" Binding="{Binding ReturnQty, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</Window>
