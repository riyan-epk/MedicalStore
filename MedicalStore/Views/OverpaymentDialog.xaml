<Window x:Class="MedicalStore.Views.OverpaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overpayment Detected" SizeToContent="Height" Width="460"
        MaxHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgPrimaryBrush}">
    <Border Background="White" CornerRadius="14" Margin="12" Padding="22,18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Scrollable content area -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,0">
                <StackPanel>

                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="Overpayment Detected" FontSize="17" FontWeight="Bold"
                                       Foreground="#1A237E"/>
                            <TextBlock Text="Customer paid more than the bill amount." FontSize="11"
                                       Foreground="#546E7A" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Height="1" Background="#E3E8EF" Margin="0,10,0,14"/>

                    <!-- Amount Summary -->
                    <Border CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E3F2FD" Offset="0"/>
                                <GradientStop Color="#F3E5F5" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Bill Total -->
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="Bill Total (Sales Revenue)" FontSize="12"
                                           Foreground="#455A64"/>
                                <TextBlock x:Name="lblBillTotal" Text="Rs 0.00"
                                           HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#1A237E"/>
                            </Grid>

                            <!-- Received -->
                            <Grid Grid.Row="1" Margin="0,0,0,4">
                                <TextBlock Text="Amount Received" FontSize="12"
                                           Foreground="#455A64"/>
                                <TextBlock x:Name="lblReceived" Text="Rs 0.00"
                                           HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#455A64"/>
                            </Grid>

                            <!-- Divider -->
                            <Border Grid.Row="3" Height="1" Background="#CFD8DC" Margin="0,2,0,2"/>

                            <!-- Excess -->
                            <Grid Grid.Row="4" Margin="0,2,0,0">
                                <TextBlock Text="Excess Amount" FontSize="13" FontWeight="Bold"
                                           Foreground="#E65100"/>
                                <TextBlock x:Name="lblExcess" Text="Rs 0.00"
                                           HorizontalAlignment="Right" FontSize="14" FontWeight="Bold"
                                           Foreground="#E65100"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Question -->
                    <TextBlock Text="What should be done with the excess amount?"
                               FontSize="12" FontWeight="SemiBold" Foreground="#37474F"
                               Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <!-- Option 1: Return to Customer -->
                    <Border x:Name="borderReturnOption" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"
                            BorderThickness="2" BorderBrush="#4CAF50" Background="#F1F8E9"
                            Cursor="Hand" MouseLeftButtonDown="ReturnOption_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Return Excess to Customer" FontSize="13" FontWeight="Bold"
                                           Foreground="#2E7D32"/>
                                <TextBlock Text="Hand back the extra cash. Rest is recorded as revenue."
                                           FontSize="10" Foreground="#558B2F" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                <StackPanel Orientation="Horizontal" Visibility="Visible">
                                    <TextBlock Text="Return Amount:" VerticalAlignment="Center" FontSize="11" Foreground="#2E7D32" Margin="0,0,6,0"/>
                                    <TextBlock Text="Rs" VerticalAlignment="Center" Foreground="#2E7D32" FontWeight="Bold" Margin="0,0,4,0"/>
                                    <TextBox x:Name="txtReturnAmount" Width="75" Height="24" VerticalContentAlignment="Center"
                                             Background="White" BorderBrush="#A5D6A7" BorderThickness="1" 
                                             Padding="4,0" FontWeight="Bold" Foreground="#1B5E20" FontSize="12"
                                             PreviewTextInput="NumberValidation" GotFocus="txtReturnAmount_GotFocus"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="chkReturn" Text="" FontSize="20"
                                       VerticalAlignment="Center" Foreground="#4CAF50" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Option 2: Add to Credit Balance -->
                    <Border x:Name="borderCreditOption" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"
                            BorderThickness="2" BorderBrush="#D0D0D0" Background="#FAFAFA"
                            Cursor="Hand" MouseLeftButtonDown="CreditOption_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Add to Customer Credit Balance" FontSize="13" FontWeight="Bold"
                                           Foreground="#1565C0"/>
                                <TextBlock Text="Store the excess as advance credit. It will be applied on next purchase."
                                           FontSize="10" Foreground="#1976D2" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="chkCredit" Text="" FontSize="20"
                                       VerticalAlignment="Center" Foreground="#1565C0" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Option 3: Adjust to Sale -->
                    <Border x:Name="borderAdjustOption" CornerRadius="10" Padding="12,10" Margin="0,0,0,10"
                            BorderThickness="2" BorderBrush="#D0D0D0" Background="#FAFAFA"
                            Cursor="Hand" MouseLeftButtonDown="AdjustOption_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Adjust to Sale" FontSize="13" FontWeight="Bold"
                                           Foreground="#F57C00"/>
                                <TextBlock Text="Keep the excess as additional sales revenue. No credit is given."
                                           FontSize="10" Foreground="#FB8C00" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="chkAdjust" Text="" FontSize="20"
                                       VerticalAlignment="Center" Foreground="#F57C00" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Note -->
                    <Border CornerRadius="6" Padding="10,6" Background="#FFF8E1" Margin="0,0,0,4">
                        <TextBlock FontSize="10" Foreground="#E65100" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold">Note: </Run>
                            <Run>Under no condition will the excess amount be counted as sales revenue.</Run>
                        </TextBlock>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Action Buttons - Always visible at bottom -->
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Style="{StaticResource DangerButton}"
                        Click="Cancel_Click" MinHeight="40" FontSize="13"/>
                <Button Grid.Column="2" x:Name="btnConfirm" Content="Confirm" Style="{StaticResource SuccessButton}"
                        Click="Confirm_Click" MinHeight="40" FontSize="13" IsEnabled="False"/>
            </Grid>

        </Grid>
    </Border>
</Window>
