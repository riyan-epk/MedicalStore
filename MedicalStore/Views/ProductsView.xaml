<Page x:Class="MedicalStore.Views.ProductsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Products" Background="{StaticResource BgPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Toolbar -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.06"/>
            </Border.Effect>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Add Product" 
                        Style="{StaticResource PrimaryButton}" Click="AddProduct_Click" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Bulk Import" 
                        Style="{StaticResource AccentButton}" Click="BulkImport_Click" Margin="8,0,0,0"
                        ToolTip="Import products from Excel file"/>
                <Button DockPanel.Dock="Right" Content="All Products" 
                        Style="{StaticResource SuccessButton}" Click="AllProducts_Click" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Low Stock" 
                        Style="{StaticResource AccentButton}" Click="LowStock_Click" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Near Expiry" 
                        Style="{StaticResource DangerButton}" Click="NearExpiry_Click" Margin="8,0,0,0"/>
                <TextBox x:Name="txtSearch" Style="{StaticResource ModernTextBox}" 
                         TextChanged="txtSearch_TextChanged" Width="400"
                         Tag="Search by name, category, or batch number..."/>
            </DockPanel>
        </Border>
        
        <!-- Category Navbar -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,16">
            <ItemsControl x:Name="icCategories">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Name}" Margin="0,0,8,0" Padding="16,8" FontSize="13"
                                Style="{StaticResource PrimaryButton}" Background="#E8F0FE" Foreground="#1A73E8" BorderBrush="Transparent"
                                Click="CategoryFilter_Click"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <!-- Products DataGrid -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.06"/>
            </Border.Effect>
                <DataGrid x:Name="dgProducts" Style="{StaticResource ModernDataGrid}" 
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          MouseDoubleClick="dgProducts_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="Auto" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category.Name}" Width="Auto" />
                        <DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="Auto" />
                        <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="Auto" />
                        <DataGridTextColumn Header="Buy Price" Binding="{Binding PurchasePrice, StringFormat=Rs {0:N2}}" Width="Auto" />
                        <DataGridTextColumn Header="Pack Price" Binding="{Binding PackPrice, StringFormat=Rs {0:N2}}" Width="Auto" />
                        <DataGridTextColumn Header="Sale Price" Binding="{Binding SalePrice, StringFormat=Rs {0:N2}}" Width="Auto" />
                        <DataGridTextColumn x:Name="colUnitsPerPack" Header="Units/Pack" Binding="{Binding UnitsPerPack}" Width="Auto" />
                        <DataGridTextColumn x:Name="colStock" Header="Stock" Binding="{Binding StockDisplay}" Width="Auto" />
                        <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, StringFormat=dd/MM/yyyy}" Width="Auto" />
                        <DataGridTemplateColumn Header="Actions" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Delete" Style="{StaticResource DangerButton}" Height="26" FontSize="11" Click="DeleteProduct_Click" Padding="4,0" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
        </Border>
    </Grid>
</Page>



