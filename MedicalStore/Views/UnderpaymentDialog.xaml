<Window x:Class="MedicalStore.Views.UnderpaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Underpayment Detected" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgPrimaryBrush}">
    <Border Background="White" CornerRadius="14" Margin="16" Padding="28,24">
        <StackPanel>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="Underpayment Detected" FontSize="18" FontWeight="Bold"
                               Foreground="#1A237E"/>
                    <TextBlock Text="Customer paid less than the bill amount." FontSize="12"
                               Foreground="#546E7A" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Divider -->
            <Border Height="1" Background="#E3E8EF" Margin="0,14,0,18"/>

            <!-- Amount Summary -->
            <Border CornerRadius="10" Padding="14,12" Margin="0,0,0,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFF3E0" Offset="0"/>
                        <GradientStop Color="#FFCCBC" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="Total Payable" FontSize="13" Foreground="#455A64"/>
                        <TextBlock x:Name="lblBillTotal" Text="Rs 0.00"
                                   HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1A237E"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <TextBlock Text="Amount Received" FontSize="13" Foreground="#455A64"/>
                        <TextBlock x:Name="lblReceived" Text="Rs 0.00"
                                   HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#455A64"/>
                    </Grid>

                    <Border Grid.Row="3" Height="1" Background="#CFD8DC" Margin="0,4,0,4"/>

                    <Grid Grid.Row="4" Margin="0,4,0,0">
                        <TextBlock Text="Remaining Due" FontSize="14" FontWeight="Bold"
                                   Foreground="#D32F2F"/>
                        <TextBlock x:Name="lblRemaining" Text="Rs 0.00"
                                   HorizontalAlignment="Right" FontSize="15" FontWeight="Bold"
                                   Foreground="#D32F2F"/>
                    </Grid>
                </Grid>
            </Border>

            <TextBlock Text="How should this remaining amount be handled?"
                       FontSize="13" FontWeight="SemiBold" Foreground="#37474F"
                       Margin="0,0,0,16" TextWrapping="Wrap"/>

            <!-- Option 1: Add to Dues -->
            <Border x:Name="borderDuesOption" CornerRadius="10" Padding="16,14" Margin="0,0,0,10"
                    BorderThickness="2" BorderBrush="#1565C0" Background="#E3F2FD"
                    Cursor="Hand" MouseLeftButtonDown="DuesOption_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Add to Customer Dues" FontSize="14" FontWeight="Bold"
                                   Foreground="#1565C0"/>
                        <TextBlock Text="Keep the original bill amount. The remaining balance will be added to the customer's dues."
                                   FontSize="11" Foreground="#1976D2" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" x:Name="chkDues" Text="✓" FontSize="22"
                               VerticalAlignment="Center" Foreground="#1565C0" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Option 2: Adjust Sale -->
            <Border x:Name="borderAdjustOption" CornerRadius="10" Padding="16,14" Margin="0,0,0,20"
                    BorderThickness="2" BorderBrush="#D0D0D0" Background="#FAFAFA"
                    Cursor="Hand" MouseLeftButtonDown="AdjustOption_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Adjust Sale Amount" FontSize="14" FontWeight="Bold" Foreground="#2E7D32"/>
                        <TextBlock Text="Auto-apply an extra discount so the bill matches the paid amount exactly (No dues created)."
                                   FontSize="11" Foreground="#558B2F" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" x:Name="chkAdjust" Text="" FontSize="22"
                               VerticalAlignment="Center" Foreground="#4CAF50" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource DangerButton}"
                        Click="Cancel_Click" Width="90" Margin="0,0,12,0" Height="40"/>
                <Button x:Name="btnConfirm" Content="Confirm" Style="{StaticResource SuccessButton}"
                        Click="Confirm_Click" Width="140" Height="40" IsEnabled="False"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
