<Page x:Class="MedicalStore.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      Title="Dashboard" Background="{StaticResource BgPrimaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,24">

            <!-- Page Header -->
            <Border Margin="0,0,0,20" Padding="20,14">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Dashboard" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                            <Run Text="Last updated: "/>
                            <Run x:Name="runLastUpdated" Text=""/>
                        </TextBlock>
                    </StackPanel>
                    <Button x:Name="btnRefresh" Content="Refresh" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Style="{StaticResource PrimaryButton}"
                            Click="BtnRefresh_Click"/>
                </Grid>
            </Border>

            <!-- Row 1: Financial KPIs -->
            <UniformGrid Columns="4" Margin="0,0,0,14">

                <!-- Today Sales -->
                <Border Style="{StaticResource SummaryCard}" Background="{StaticResource Card1Gradient}" Margin="0,0,6,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <iconPacks:PackIconMaterial Kind="CashRegister" Width="20" Height="20" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Today's Sales" FontSize="12" Foreground="#C8FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="lblTodaySales" Text="Rs 0" FontSize="24" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock x:Name="lblTodaySalesCount" Text="0 transactions" FontSize="11"
                                   Foreground="#A0FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Today Profit -->
                <Border Style="{StaticResource SummaryCard}" Background="{StaticResource Card6Gradient}" Margin="6,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <iconPacks:PackIconMaterial Kind="TrendingUp" Width="20" Height="20" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Today's Profit" FontSize="12" Foreground="#C8FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="lblTodayProfit" Text="Rs 0" FontSize="24" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Gross profit today" FontSize="11" Foreground="#A0FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Today Purchases -->
                <Border Style="{StaticResource SummaryCard}" Background="{StaticResource Card4Gradient}" Margin="6,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <iconPacks:PackIconMaterial Kind="CartArrowDown" Width="20" Height="20" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Today's Purchases" FontSize="12" Foreground="#C8FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="lblTodayPurchases" Text="Rs 0" FontSize="24" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Stock purchased" FontSize="11" Foreground="#A0FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Total Dues highlighted Red -->
                <Border Style="{StaticResource SummaryCard}" Background="{StaticResource Card5Gradient}" Margin="6,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <iconPacks:PackIconMaterial Kind="AlertCircleOutline" Width="20" Height="20" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Outstanding Dues" FontSize="12" Foreground="#C8FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="lblDues" Text="Rs 0" FontSize="24" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Total customer dues" FontSize="11" Foreground="#A0FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Row 2: Inventory / Status KPIs -->
            <UniformGrid Columns="4" Margin="0,0,0,20">

                <!-- Total Products -->
                <Border Background="White" CornerRadius="12" Padding="16,14" Margin="0,0,6,0">
                    <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="8" Opacity="0.08"/></Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Background="#E8F5E9" CornerRadius="6" Width="32" Height="32" Margin="0,0,10,0">
                                <iconPacks:PackIconMaterial Kind="PackageVariant" Width="16" Height="16" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Total Products" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="lblTotalProducts" Text="0" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Active SKUs in stock" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Low Stock Orange indicator -->
                <Border Background="White" CornerRadius="12" Padding="16,14" Margin="6,0">
                    <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="8" Opacity="0.08"/></Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Background="#FFF3E0" CornerRadius="6" Width="32" Height="32" Margin="0,0,10,0">
                                <iconPacks:PackIconMaterial Kind="AlertOutline" Width="16" Height="16" Foreground="#F57C00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Low Stock" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="lblLowStock" Text="0" FontSize="28" FontWeight="Bold"
                                   Foreground="#F57C00"/>
                        <TextBlock Text="Items below minimum level" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Near Expiry Orange -->
                <Border Background="White" CornerRadius="12" Padding="16,14" Margin="6,0">
                    <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="8" Opacity="0.08"/></Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Background="#FFF8E1" CornerRadius="6" Width="32" Height="32" Margin="0,0,10,0">
                                <iconPacks:PackIconMaterial Kind="ClockAlertOutline" Width="16" Height="16" Foreground="#EF6C00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Near Expiry" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="lblNearExpiry" Text="0" FontSize="28" FontWeight="Bold"
                                   Foreground="#EF6C00"/>
                        <TextBlock Text="Items expiring soon" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Today Returns -->
                <Border Background="White" CornerRadius="12" Padding="16,14" Margin="6,0,0,0">
                    <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="8" Opacity="0.08"/></Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Background="#FCE4EC" CornerRadius="6" Width="32" Height="32" Margin="0,0,10,0">
                                <iconPacks:PackIconMaterial Kind="KeyboardReturn" Width="16" Height="16" Foreground="#C2185B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Today's Returns" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="lblTodayReturns" Text="Rs 0" FontSize="28" FontWeight="Bold"
                                   Foreground="#C62828"/>
                        <TextBlock Text="Returned value today" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Charts Row 1 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Daily Sales Line Chart -->
                <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="20" Margin="0,0,10,0">
                    <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="10" Opacity="0.08"/></Border.Effect>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Daily Sales Last 30 Days" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Revenue trend by day" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="#EEF4FF" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="Line Chart" FontSize="11" Foreground="#1A73E8" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                        <lvc:CartesianChart x:Name="chartDailySales" Height="230"/>
                    </DockPanel>
                </Border>

                <!-- Category Pie Chart -->
                <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="20" Margin="10,0,0,0">
                    <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="10" Opacity="0.08"/></Border.Effect>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="Category Sales" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="This month by category" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <lvc:PieChart x:Name="chartCategory" Height="230"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Charts Row 2 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sales vs Purchases Bar Chart -->
                <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="20" Margin="0,0,10,0">
                    <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="10" Opacity="0.08"/></Border.Effect>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="Sales vs Purchases 6 Months" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="10" Height="10" Fill="#1A73E8" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Sales" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0"/>
                                <Ellipse Width="10" Height="10" Fill="#FF9800" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Purchases" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <lvc:CartesianChart x:Name="chartSalesVsPurchases" Height="230"/>
                    </DockPanel>
                </Border>

                <!-- Recent Sales Table -->
                <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="20" Margin="10,0,0,0">
                    <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="10" Opacity="0.08"/></Border.Effect>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Recent Sales" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Last 10 transactions" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="230">
                            <DataGrid x:Name="dgRecentSales" Style="{StaticResource ModernDataGrid}" 
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNo}" Width="Auto" />
                                    <DataGridTextColumn Header="Customer" Binding="{Binding Customer.Name}" Width="Auto" />
                                    <DataGridTemplateColumn Header="Amount" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding NetAmount, Converter={StaticResource CurrencyConverter}}"
                                                           FontWeight="SemiBold" Foreground="#1A73E8"
                                                           HorizontalAlignment="Right" Margin="4,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Due" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock FontWeight="SemiBold" HorizontalAlignment="Right" Margin="4,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding DueAmount, Converter={StaticResource CurrencyConverter}}"/>
                                                            <Setter Property="Foreground" Value="#E53935"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DueAmount}" Value="0">
                                                                    <Setter Property="Text" Value="Paid"/>
                                                                    <Setter Property="Foreground" Value="#43A047"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd MMM yyyy}" Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>



