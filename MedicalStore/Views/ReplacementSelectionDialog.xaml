<Window x:Class="MedicalStore.Views.ReplacementSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Replacement Product"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Width="680" Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Search Box Style -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D7E3"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="38,10,12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#94A3B8"
                                           FontSize="13"
                                           Margin="38,0,12,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox Item Style -->
        <Style x:Key="ProductListItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#E8EDF4"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EEF4FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#DBEAFE"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Qty Buttons -->
        <Style x:Key="QtyBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#EEF4FF"/>
            <Setter Property="Foreground" Value="#1A73E8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#BFDBFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1A73E8" Padding="24,18">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Select Replacement Product" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="lblRefundContext" Text="" FontSize="12" Foreground="#BFDBFE" Margin="0,4,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Content="X" FontSize="16" Foreground="White"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="CloseDialog_Click"
                        Width="32" Height="32"/>
            </Grid>
        </Border>

        <!-- Info Bar for selected refund item -->
        <Border Grid.Row="1" Background="#FFFDE7" BorderBrush="#FDD835" BorderThickness="0,0,0,2" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Refunding: " FontSize="13" Foreground="#795548" FontWeight="SemiBold"/>
                    <TextBlock x:Name="lblRefundProduct" Text="" FontSize="13" Foreground="#4E342E" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Qty: " FontSize="13" Foreground="#795548"/>
                    <TextBlock x:Name="lblRefundQty" Text="" FontSize="13" FontWeight="Bold" Foreground="#4E342E"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Max Replacement: " FontSize="13" Foreground="#795548"/>
                    <TextBlock x:Name="lblMaxReplacement" Text="" FontSize="13" FontWeight="Bold" Foreground="#E53935"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Product Search + List -->
        <Border Grid.Row="2" Background="White" Margin="20,16,20,0" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="8" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search Bar -->
                <Grid Grid.Row="0" Margin="16,14,16,8">
                    <TextBox x:Name="txtSearch"
                             Style="{StaticResource SearchBox}"
                             Tag="Search products by name, company, batch..."
                             TextChanged="txtSearch_TextChanged"
                             PreviewKeyDown="txtSearch_PreviewKeyDown"/>
                    <iconPacks:PackIconMaterial Kind="Magnify" Width="16" Height="16" Margin="12,0,0,0"
                                                VerticalAlignment="Center" Foreground="#94A3B8" IsHitTestVisible="False"/>
                </Grid>

                <!-- Product List -->
                <ListBox x:Name="lstProducts"
                         Grid.Row="1"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource ProductListItem}"
                         SelectionChanged="lstProducts_SelectionChanged"
                         KeyDown="lstProducts_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="11" Foreground="#64748B" Margin="0,2,0,0">
                                        <Run Text="{Binding Company}"/>
                                        <Run Text=" Batch:"/>
                                        <Run Text="{Binding BatchNo}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Price Badge -->
                                <Border Grid.Column="2" CornerRadius="6" Padding="8,4"
                                        Background="#E8F5E9" VerticalAlignment="Center" Margin="8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Rs " FontSize="11" Foreground="#2E7D32" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SalePrice, Converter={StaticResource RawCurrencyConverter}}"
                                                   FontSize="12" FontWeight="Bold" Foreground="#1B5E20"/>
                                    </StackPanel>
                                </Border>

                                <!-- Stock Badge -->
                                <Border Grid.Column="3" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E3F2FD"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Quantity}" Value="0">
                                                    <Setter Property="Background" Value="#FFEBEE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Stock: " FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1565C0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Quantity}" Value="0">
                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Quantity}" FontSize="12" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1565C0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Quantity}" Value="0">
                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Quantity Selection (shown when product selected) -->
        <Border x:Name="panelQtySelection" Grid.Row="3"
                Background="White" Margin="20,12,20,0"
                CornerRadius="12" Padding="20,14"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="8" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Selected Replacement:" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock x:Name="lblSelectedProduct" Text="" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,2,0,0"/>
                    <TextBlock x:Name="lblSelectedStock" Text="" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Qty:" FontSize="13" FontWeight="SemiBold" Foreground="#475569"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="-" Style="{StaticResource QtyBtn}" Click="DecrementQty_Click"/>
                    <Border Background="#F8FAFC" BorderBrush="#D0D7E3" BorderThickness="1" CornerRadius="8"
                            Width="56" Margin="6,0">
                        <TextBox x:Name="txtQty" Text="1" TextAlignment="Center"
                                 FontSize="15" FontWeight="Bold" BorderThickness="0"
                                 Background="Transparent" VerticalContentAlignment="Center"
                                 Padding="0,6" TextChanged="txtQty_TextChanged"/>
                    </Border>
                    <Button Content="+" Style="{StaticResource QtyBtn}" Click="IncrementQty_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer Buttons -->
        <Border Grid.Row="4" Padding="20,14" Background="White"
                BorderBrush="#E8EDF4" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="lblValidation" Text="" FontSize="12"
                               Foreground="#E53935" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="CloseDialog_Click"
                            Width="100" Height="38" Margin="0,0,8,0"
                            Cursor="Hand"
                            Background="#F1F5F9" Foreground="#475569"
                            BorderThickness="0" FontSize="13" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E2E8F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="btnConfirm" Content="Confirm Replacement"
                            Click="Confirm_Click"
                            Height="38" Padding="20,0"
                            Cursor="Hand"
                            Background="#1A73E8" Foreground="White"
                            BorderThickness="0" FontSize="13" FontWeight="SemiBold"
                            IsEnabled="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                        Opacity="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}, Converter={x:Null}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1557C0"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#0F3FA0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>



