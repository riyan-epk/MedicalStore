<Page x:Class="MedicalStore.Views.ReturnsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      Title="Returns" Background="{StaticResource BgPrimaryBrush}"
      PreviewKeyDown="Page_PreviewKeyDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Page Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Returns &amp; Replacements" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Search an invoice, select items to return and optionally add replacements"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource SummaryCard}" Background="{StaticResource Card1Gradient}"
                            Margin="0,0,12,0" Width="150" Height="68">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Today's Returns" Foreground="White" FontSize="11"/>
                            <TextBlock x:Name="lblTodayCount" Text="0" Foreground="White"
                                       FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCard}" Background="{StaticResource Card4Gradient}"
                            Width="165" Height="68">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Today Refunds" Foreground="White" FontSize="11"/>
                            <TextBlock x:Name="lblTodayRefundAmount" Text="Rs 0" Foreground="White"
                                       FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>

            <!-- Invoice Search Bar -->
            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16,14" Margin="0,0,0,14">
                <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.07"/></Border.Effect>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Back to POS" Style="{StaticResource PrimaryButton}"
                            Background="{StaticResource BgSidebarBrush}"
                            Margin="0,0,20,0" Click="BackToPos_Click" Height="38"/>

                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Search Invoice No." FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="cmbInvoiceNo" Width="260" Height="38"
                                      DisplayMemberPath="InvoiceNo" SelectedValuePath="InvoiceNo"
                                      IsEditable="True" Style="{StaticResource ModernComboBox}"/>
                            <Button Content="Find Invoice" Style="{StaticResource PrimaryButton}"
                                    Margin="8,0,0,0" Height="38" Click="FindInvoice_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <Border x:Name="borderInvoiceInfo" Background="#EEF4FF" CornerRadius="8" Padding="12,8"
                            VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,16,0">
                        <TextBlock x:Name="lblInvoiceInfo" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1A73E8"/>
                    </Border>


                </WrapPanel>
            </Border>

            <!-- Items: side-by-side (two equal columns, horizontal scroll per panel) -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="340"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*" MinWidth="340"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Returned Items -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16">
                    <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.07"/></Border.Effect>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Select Items to Return" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Check items and enter return quantities"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <DataGrid x:Name="dgInvoiceItems" Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="160"
                                  RowHeight="40"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <!-- Explicit CellStyle so every cell has consistent vertical padding -->
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <!-- Checkbox column: 56px, explicit centred cell -->
                                <DataGridTemplateColumn Width="Auto"> 
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="Se" FontSize="12" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Width="18" Height="18"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Product"     Binding="{Binding ProductName}"                  Width="Auto"    IsReadOnly="True"/>
                                <DataGridTextColumn Header="Available"   Binding="{Binding SoldQty}"                     Width="Auto"    IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Return Qty" Width="Auto"> 
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding ReturnQty, UpdateSourceTrigger=PropertyChanged}"
                                                     TextAlignment="Center" VerticalContentAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Unit Price"  Binding="{Binding UnitPrice, Converter={StaticResource CurrencyConverter}}" Width="Auto"  IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>

                    </DockPanel>
                </Border>

                <!-- Right: Replacement Items -->
                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="16">
                    <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.07"/></Border.Effect>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="Replacement Items (Optional)" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Search and add products to give as replacements"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBox x:Name="txtReplaceSearch" Style="{StaticResource ModernTextBox}"
                                     Tag="Search products for replacement..."
                                     TextChanged="txtReplaceSearch_TextChanged" PreviewKeyDown="txtReplaceSearch_PreviewKeyDown"/>
                            <Popup x:Name="popupReplace" PlacementTarget="{Binding ElementName=txtReplaceSearch}"
                                   Placement="Bottom" StaysOpen="False"
                                   Width="{Binding ActualWidth, ElementName=txtReplaceSearch}">
                                <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="0,0,8,8">
                                    <Border.Effect><DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.12"/></Border.Effect>
                                    <ListBox x:Name="lstReplaceResults"
                                             PreviewMouseLeftButtonUp="ReplaceList_MouseUp"
                                             PreviewKeyDown="ReplaceList_KeyDown" MaxHeight="250" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Category.Name}"
                                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" CornerRadius="4" Padding="6,2" Margin="10,0,6,0"
                                                            Background="#E8F5E9" VerticalAlignment="Center">
                                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32">
                                                            <Run Text="Rs "/>
                                                            <Run Text="{Binding SalePrice, Converter={StaticResource RawCurrencyConverter}}"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#E3F2FD"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Quantity}" Value="0">
                                                                        <Setter Property="Background" Value="#FFEBEE"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                                            <Run Text="Stock: "/>
                                                            <Run Text="{Binding Quantity}"/>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#1565C0"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Quantity}" Value="0">
                                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                        <DataGrid x:Name="dgReplacement" Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="160"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Product"    Binding="{Binding ProductName}"                    Width="Auto"    IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Qty"    Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Content="-" Width="26" Height="26" Click="DecreaseReplaceQty_Click"
                                                        Background="#E2E8F0" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="16"/>
                                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="36"
                                                         TextAlignment="Center" VerticalAlignment="Center" Margin="2,0"
                                                         FontWeight="SemiBold" Padding="0,4" Style="{StaticResource ModernTextBox}"
                                                         PreviewTextInput="NumberValidation"/>
                                                <Button Content="+" Width="26" Height="26" Click="IncreaseReplaceQty_Click"
                                                        Background="#E2E8F0" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="16"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, Converter={StaticResource CurrencyConverter}}" Width="Auto" />
                                <DataGridTextColumn Header="Total"      Binding="{Binding Total,     Converter={StaticResource CurrencyConverter}}" Width="Auto"  IsReadOnly="True"/>
                                <!-- Delete button: explicit 30x30 red circle, always visible -->
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="30" Height="30" CornerRadius="15"
                                                    Background="#FFEBEE" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{x:Static ApplicationCommands.NotACommand}"/>
                                                </Border.InputBindings>
                                                <Button Content="X" FontSize="12" FontWeight="Bold"
                                                        Foreground="#E53935" Background="Transparent"
                                                        BorderThickness="0" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" Cursor="Hand"
                                                        Click="RemoveReplacementItem_Click"
                                                        ToolTip="Remove item"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Financial Summary (Bottom) -->
            <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,10">
                <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.07"/></Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" MinWidth="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Notes -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="Return Notes" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtReturnNotes" Style="{StaticResource ModernTextBox}"
                                 Tag="Reason for return or additional notes..."
                                 Height="100" TextWrapping="Wrap" AcceptsReturn="True"/>
                        <CheckBox x:Name="chkRestock" Content="Restock returned items (uncheck if damaged/expired)"
                                  IsChecked="True" Margin="0,10,0,0" FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Summary -->
                    <StackPanel Grid.Column="1">

                        <!-- Returned / Replacement rows -->
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="Returned Value:" FontSize="13"/>
                            <TextBlock x:Name="lblReturnedTotal" Text="Rs 0.00"
                                       HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#43A047"/>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="Replacement Value:" FontSize="13"/>
                            <TextBlock x:Name="lblReplacementTotal" Text="Rs 0.00"
                                       HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#1A73E8"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Net Difference (Rep Ret):" FontSize="11"
                                       FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="lblNetDiffValue" Text="Rs 0.00"
                                       HorizontalAlignment="Right" FontSize="11" FontStyle="Italic"/>
                        </Grid>

                        <!-- Previous Dues (conditional) -->
                        <Grid x:Name="gridPreviousDues" Margin="0,0,0,5" Visibility="Collapsed">
                            <TextBlock Text="Existing Due Balance:" FontSize="13" Foreground="#E65100"/>
                            <TextBlock x:Name="lblPreviousDuesVal" Text="Rs 0.00"
                                       HorizontalAlignment="Right" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}"/>
                        </Grid>

                        <!-- Total Net Payable -->
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8"/>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Total Net Payable:" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="lblNetDifference" Text="Rs 0.00"
                                       HorizontalAlignment="Right" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </Grid>

                        <!-- Hint (conditional) -->
                        <TextBlock x:Name="lblAdjustmentHint"
                                   Text="(Net Diff + Existing Due) includes prior balance"
                                   FontSize="10" FontStyle="Italic" HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,-6,0,8" Visibility="Collapsed"/>

                        <!-- Payment Input -->
                        <TextBlock Text="Payment Action" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbPaymentAction" Style="{StaticResource ModernComboBox}"
                                  Height="36" Margin="0,0,0,10" SelectionChanged="CmbPaymentAction_SelectionChanged">
                            <ComboBoxItem Content="Amount Paid by Customer" IsSelected="True" Tag="CustomerPays"/>
                            <ComboBoxItem Content="Refund Issued to Customer" Tag="StoreRefunds"/>
                        </ComboBox>

                        <TextBlock x:Name="lblPaymentAmount" Text="Amount Received" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtPaidByCustomer" Style="{StaticResource ModernTextBox}"
                                 Tag="Enter amount here..." Text="0" TextAlignment="Right" Padding="12,10"
                                 Margin="0,0,0,14" TextChanged="txtPaidByCustomer_TextChanged" PreviewTextInput="NumberValidation"/>

                        <!-- Confirm Button -->
                        <Button x:Name="btnConfirmProcess" Content="Confirm &amp; Process"
                                Style="{StaticResource SuccessButton}" Height="46" FontSize="14"
                                Click="ProcessReturn_Click" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>



