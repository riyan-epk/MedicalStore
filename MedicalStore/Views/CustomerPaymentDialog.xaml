<Window x:Class="MedicalStore.Views.CustomerPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record Customer Payment" SizeToContent="Height" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgPrimaryBrush}">
    <Border Background="White" CornerRadius="12" Margin="16" Padding="24">
        <StackPanel>
            <TextBlock Text="Customer Payment" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <TextBlock Text="Customer" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock x:Name="lblCustomerName" FontSize="16" FontWeight="Bold" Margin="0,4,0,16"/>
            
            <TextBlock Text="Current Balance" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock x:Name="lblBalance" FontSize="18" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,20"/>

            <TextBlock Text="Payment Method" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox x:Name="cmbMethod" Style="{StaticResource ModernComboBox}" Margin="0,0,0,16">
                <ComboBoxItem Content="Cash" IsSelected="True"/>
                <ComboBoxItem Content="Bank Transfer"/>
                <ComboBoxItem Content="Wallet"/>
            </ComboBox>

            <TextBlock Text="Amount to Pay *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="txtAmount" Style="{StaticResource ModernTextBox}" Tag="Enter amount in Rs" Margin="0,0,0,16"/>

            <TextBlock Text="Notes" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="txtNotes" Style="{StaticResource ModernTextBox}" Tag="Optional reference or notes" Height="60" TextWrapping="Wrap" Margin="0,0,0,24"/>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Style="{StaticResource DangerButton}" Click="Cancel_Click" MinHeight="42" FontSize="14"/>
                <Button Grid.Column="2" Content="Confirm Payment" Style="{StaticResource SuccessButton}" Click="Save_Click" MinHeight="42" FontSize="14"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>



