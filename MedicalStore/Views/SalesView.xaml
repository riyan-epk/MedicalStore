<Page x:Class="MedicalStore.Views.SalesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Sales Tracking" Background="{StaticResource BgPrimaryBrush}">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- KPI Cards -->
        <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,12">
            <Border Background="{StaticResource Card1Gradient}" CornerRadius="12" Padding="16,12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Today's Sales" FontSize="12" Foreground="#C8FFFFFF"/>
                    <TextBlock x:Name="lblTodaySales" Text="Rs 0" FontSize="22" FontWeight="Bold"
                               Foreground="White" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border x:Name="cardProfitToday" Background="{StaticResource Card6Gradient}" CornerRadius="12" Padding="16,12" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="Profit Today" FontSize="12" Foreground="#C8FFFFFF"/>
                    <TextBlock x:Name="lblTodayProfit" Text="Rs 0" FontSize="22" FontWeight="Bold"
                               Foreground="White" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource Card4Gradient}" CornerRadius="12" Padding="16,12" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Total Due Today" FontSize="12" Foreground="#C8FFFFFF"/>
                    <TextBlock x:Name="lblTodayDue" Text="Rs 0" FontSize="22" FontWeight="Bold"
                               Foreground="White" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Filter Bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
            <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.06"/></Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="From" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                        <DatePicker x:Name="dpFrom" Height="36" Width="140" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="To" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                        <DatePicker x:Name="dpTo" Height="36" Width="140" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,12" Width="180">
                        <TextBlock Text="Customer" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                        <ComboBox x:Name="cmbCustomer" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  Height="36" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,12" Width="160">
                        <TextBlock Text="Invoice No" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtInvoice" Style="{StaticResource ModernTextBox}"
                                 Tag="INV-..." Height="36" FontSize="13" Padding="8,0" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,18,0,0">
                    <Button Content="Search" Style="{StaticResource PrimaryButton}"
                            Click="BtnSearch_Click" Height="36" Padding="14,0" Margin="0,0,6,0" FontSize="12"/>
                    <Button Content="Reset" Style="{StaticResource AccentButton}"
                            Click="BtnReset_Click" Height="36" Padding="14,0" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sales DataGrid -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16">
            <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.06"/></Border.Effect>
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Sales History" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="lblSalesCount" Text="0 records" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
                <!-- ScrollViewer wrapper ensures independent horizontal scroll even inside DockPanel -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                <DataGrid x:Name="dgSales" Style="{StaticResource ModernDataGrid}"
                          IsReadOnly="True" CanUserAddRows="False"
                          RowHeight="38"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          MinHeight="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice"  Binding="{Binding InvoiceNo}"                          Width="Auto" />
                        <DataGridTextColumn Header="Date"     Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="Auto" />
                        <DataGridTextColumn Header="Customer" Binding="{Binding Customer.Name}"                       Width="Auto"   />
                        <DataGridTextColumn Header="SubTotal" Binding="{Binding SubTotal,  StringFormat='Rs {0:N2}'}" Width="Auto" />
                        <DataGridTextColumn Header="Discount" Binding="{Binding Discount,  StringFormat='Rs {0:N2}'}" Width="Auto" />
                        <DataGridTextColumn Header="Net"      Binding="{Binding NetAmount,  StringFormat='Rs {0:N2}'}" Width="Auto" />
                        <DataGridTextColumn x:Name="colProfit" Header="Profit"   Binding="{Binding Profit,     StringFormat='Rs {0:N2}'}" Width="Auto" />
                        <DataGridTextColumn Header="Paid"     Binding="{Binding PaidAmount,  StringFormat='Rs {0:N2}'}" Width="Auto" />
                        <!-- Due column: green badge when 0, red amount when outstanding -->
                        <DataGridTemplateColumn Header="Due" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="SemiBold" HorizontalAlignment="Right" Margin="4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding DueAmount, StringFormat='Rs {0:N2}'}"/>
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DueAmount}" Value="0">
                                                        <Setter Property="Text" Value="Paid"/>
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- Action: wider so "Return" is never clipped -->
                        <DataGridTemplateColumn Header="Action" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Return" Style="{StaticResource AccentButton}"
                                            FontSize="12" Height="30" Padding="12,0"
                                            HorizontalAlignment="Center"
                                            Click="ReturnButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Page>



