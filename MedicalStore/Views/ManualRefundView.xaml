<Page x:Class="MedicalStore.Views.ManualRefundView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Manual Refund" Background="{StaticResource BgPrimaryBrush}"
      PreviewKeyDown="Page_PreviewKeyDown">
    <ScrollViewer>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Page Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Manual Product Refund" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Process refunds directly without requiring an original invoice. Select products to refund, optionally assign replacements, and confirm."
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Product Search and Input Section -->
            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.06"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Product Search -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Search Product to Refund" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid>
                            <TextBox x:Name="txtProductSearch" Style="{StaticResource ModernTextBox}"
                                     Tag="Type product name, batch or company..."
                                     TextChanged="txtProductSearch_TextChanged"
                                     PreviewKeyDown="txtProductSearch_PreviewKeyDown"/>
                            <Popup x:Name="popupSearch" PlacementTarget="{Binding ElementName=txtProductSearch}"
                                   Placement="Bottom" StaysOpen="False"
                                   Width="{Binding ActualWidth, ElementName=txtProductSearch}">
                                <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="0,0,8,8">
                                    <Border.Effect><DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.12"/></Border.Effect>
                                    <ListBox x:Name="lstSearchResults"
                                             PreviewMouseLeftButtonUp="ProductList_MouseUp"
                                             PreviewKeyDown="ProductList_KeyDown"
                                             MaxHeight="250" Padding="0" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Category.Name}"
                                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" CornerRadius="4" Padding="6,2"
                                                            Margin="10,0,6,0" Background="#E8F5E9" VerticalAlignment="Center">
                                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32">
                                                            <Run Text="Rs "/><Run Text="{Binding SalePrice, Converter={StaticResource RawCurrencyConverter}}"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#E3F2FD"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Quantity}" Value="0">
                                                                        <Setter Property="Background" Value="#FFEBEE"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                                            <Run Text="Stock: "/><Run Text="{Binding Quantity}"/>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#1565C0"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Quantity}" Value="0">
                                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                        <TextBlock x:Name="lblSelectedProduct" Text="No product selected"
                                   Foreground="#1A73E8" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Refund Qty -->
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Refund Quantity" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtQty" Style="{StaticResource ModernTextBox}"
                                 Tag="1" Text="1" TextChanged="CalculateTotal_Event" KeyDown="Input_KeyDown"/>
                    </StackPanel>

                    <!-- Discount -->
                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="Discount Deducted (Rs)" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtDiscount" Style="{StaticResource ModernTextBox}"
                                 Tag="0.00" Text="0" TextChanged="CalculateTotal_Event" KeyDown="Input_KeyDown"/>
                    </StackPanel>

                    <!-- Add Button -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <Button Content="Add to Refund" Style="{StaticResource PrimaryButton}"
                                Height="38" Padding="16,0" Click="AddItem_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Refund & Replacement: side-by-side, equal columns, horizontal scroll per panel -->
            <Grid Grid.Row="2" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="340"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*" MinWidth="340"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Refund Items -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.06"/>
                    </Border.Effect>
                    <DockPanel>
                        <!-- Panel Header -->
                        <Border DockPanel.Dock="Top" Background="#FFF3E0" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Refund Items" FontSize="15" FontWeight="Bold"
                                               Foreground="#E65100"/>
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="11" Foreground="#BF360C"
                                           Text="Search replacement in the right panel"/>
                            </Grid>
                        </Border>

                        <!-- Refund DataGrid -->
                        <DataGrid x:Name="dgRefundItems" Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  MinHeight="150" VerticalAlignment="Top"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <!-- Product Name -->
                                <DataGridTextColumn Header="Product"     Binding="{Binding ProductName}"                    Width="Auto"   />
                                <!-- Price -->
                                <DataGridTextColumn Header="Unit Price"  Binding="{Binding UnitPrice,  Converter={StaticResource CurrencyConverter}}" Width="Auto" />
                                <!-- Qty -->
                                <DataGridTextColumn Header="Qty"         Binding="{Binding Quantity}"                       Width="Auto"  />
                                <!-- Discount -->
                                <DataGridTextColumn Header="Discount"    Binding="{Binding Discount,   Converter={StaticResource CurrencyConverter}}" Width="Auto" />
                                <!-- Net Refund -->
                                <DataGridTextColumn Header="Net Refund"  Binding="{Binding NetRefund,  Converter={StaticResource CurrencyConverter}}" Width="Auto" 
                                                    Foreground="{StaticResource DangerBrush}"/>
                                <!-- Remove: styled red circle badge, always visible -->
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="30" Height="30" CornerRadius="15"
                                                    Background="#FFEBEE" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" Cursor="Hand">
                                                <Button Content="X" FontSize="12" FontWeight="Bold"
                                                        Foreground="#E53935" Background="Transparent"
                                                        BorderThickness="0" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" Cursor="Hand"
                                                        Click="RemoveItem_Click"
                                                        ToolTip="Remove Refund Item"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>



                <!-- Right: Replacement Items -->
                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.06"/>
                    </Border.Effect>
                    <DockPanel>
                        <!-- Panel Header -->
                        <Border DockPanel.Dock="Top" Background="#E8F5E9" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                            <Grid>
                                <TextBlock x:Name="lblReplacementCount"
                                           Text="Replacement Items"
                                           FontSize="15" FontWeight="Bold" Foreground="#1B5E20"/>
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="11" Foreground="#388E3C"
                                           Text="Use Replace on each refund item or search below"/>
                            </Grid>
                        </Border>

                        <!-- Free-form Search (optional add unlinked replacement) -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBox x:Name="txtReplaceSearch" Style="{StaticResource ModernTextBox}"
                                     Tag="Add extra replacement (search product)..."
                                     TextChanged="txtReplaceSearch_TextChanged"
                                     PreviewKeyDown="txtReplaceSearch_PreviewKeyDown"/>
                            <Popup x:Name="popupReplace"
                                   PlacementTarget="{Binding ElementName=txtReplaceSearch}"
                                   Placement="Bottom" StaysOpen="False"
                                   Width="{Binding ActualWidth, ElementName=txtReplaceSearch}">
                                <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="0,0,8,8">
                                    <Border.Effect><DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.12"/></Border.Effect>
                                    <ListBox x:Name="lstReplaceResults"
                                             PreviewMouseLeftButtonUp="ReplaceList_MouseUp"
                                             PreviewKeyDown="ReplaceList_KeyDown"
                                             MaxHeight="250" Padding="0" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Category.Name}"
                                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" CornerRadius="4" Padding="6,2"
                                                            Margin="10,0,6,0" Background="#E8F5E9" VerticalAlignment="Center">
                                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32">
                                                            <Run Text="Rs "/><Run Text="{Binding SalePrice, Converter={StaticResource RawCurrencyConverter}}"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#E3F2FD"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Quantity}" Value="0">
                                                                        <Setter Property="Background" Value="#FFEBEE"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                                            <Run Text="Stock: "/><Run Text="{Binding Quantity}"/>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#1565C0"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Quantity}" Value="0">
                                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Replacement DataGrid -->
                        <DataGrid x:Name="dgReplacementItems" Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  MinHeight="150" VerticalAlignment="Top"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <!-- Highlight linked (per-item) replacements differently -->
                                        <DataTrigger Binding="{Binding LinkedRefundProductId}" Value="0">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <!-- Product Name -->
                                <DataGridTemplateColumn Header="Replacement Product" Width="Auto" >
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <!-- Show linked refund item if applicable -->
                                                <TextBlock FontSize="10" Foreground="#1A73E8" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LinkedRefundProductName}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="for: "/><Run Text="{Binding LinkedRefundProductName}" FontWeight="SemiBold"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Editable Qty with +/- buttons -->
                                <DataGridTemplateColumn Header="Qty" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Content="-" Width="26" Height="26" Click="DecreaseReplaceQty_Click"
                                                        Background="#E2E8F0" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="16"/>
                                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="36"
                                                         TextAlignment="Center" VerticalAlignment="Center" Margin="2,0"
                                                         FontWeight="SemiBold" Padding="0,4" Style="{StaticResource ModernTextBox}"
                                                         PreviewTextInput="NumberValidation"/>
                                                <Button Content="+" Width="26" Height="26" Click="IncreaseReplaceQty_Click"
                                                        Background="#E2E8F0" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="16"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Price -->
                                <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat='Rs {0:N2}'}"
                                                    Width="Auto"  IsReadOnly="True"/>
                                <!-- Total -->
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='Rs {0:N2}'}"
                                                    Width="Auto"  IsReadOnly="True"/>
                                <!-- Stock badge -->
                                <DataGridTemplateColumn Header="Stock" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="5,2" Margin="2" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E3F2FD"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StockAvailable}" Value="0">
                                                                <Setter Property="Background" Value="#FFEBEE"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StockAvailable}"
                                                           FontSize="11" FontWeight="SemiBold" TextAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#1565C0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StockAvailable}" Value="0">
                                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Remove: styled red circle badge, always visible -->
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="30" Height="30" CornerRadius="15"
                                                    Background="#FFEBEE" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" Cursor="Hand">
                                                <Button Content="X" FontSize="12" FontWeight="Bold"
                                                        Foreground="#E53935" Background="Transparent"
                                                        BorderThickness="0" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" Cursor="Hand"
                                                        Click="RemoveReplacementItem_Click"
                                                        ToolTip="Remove Replacement"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Financial Summary -->
            <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="12" Padding="20" Margin="0,16,0,0">
                <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.06"/></Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" MinWidth="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Customer + Invoice + Notes -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <!-- Customer -->
                        <TextBlock Text="Select Customer" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="cmbCustomer" Style="{StaticResource ModernComboBox}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id" Height="38"
                                  Margin="0,0,0,14"
                                  SelectionChanged="CmbCustomer_SelectionChanged"/>

                        <!-- Original Invoice (Optional) -->
                        <TextBlock Text="Original Invoice No. (Optional)" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtOriginalInvoice" Style="{StaticResource ModernTextBox}"
                                 Tag="Enter invoice no if available..." Height="38" Margin="0,0,0,14"/>

                        <!-- Notes -->
                        <TextBlock Text="Refund Notes" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtReturnNotes" Style="{StaticResource ModernTextBox}"
                                 Tag="Reason for return or additional notes..."
                                 Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                        <CheckBox x:Name="chkRestock" Content="Restock returned items (uncheck if damaged/expired)"
                                  IsChecked="True" Margin="0,10,0,0" FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Right: Financial Summary + Process Button -->
                    <StackPanel Grid.Column="1">
                        <!-- Gross Refund Value -->
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="Gross Refund Value:" FontSize="13"/>
                            <TextBlock x:Name="lblGrossRefund" Text="Rs 0.00"
                                       HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#43A047"/>
                        </Grid>
                        <!-- Replacement Value -->
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="Replacement Value:" FontSize="13"/>
                            <TextBlock x:Name="lblReplacementTotal" Text="Rs 0.00"
                                       HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#1A73E8"/>
                        </Grid>
                        <!-- Net Difference -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Net Difference (Rep Ref):" FontSize="11"
                                       FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="lblNetDiffValue" Text="Rs 0.00"
                                       HorizontalAlignment="Right" FontSize="11" FontStyle="Italic"/>
                        </Grid>

                        <!-- Existing Due (conditional) -->
                        <Grid x:Name="gridPreviousDues" Margin="0,0,0,5" Visibility="Collapsed">
                            <TextBlock Text="Existing Due Balance:" FontSize="13" Foreground="#E65100"/>
                            <TextBlock x:Name="lblPreviousDuesVal" Text="Rs 0.00"
                                       HorizontalAlignment="Right" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}"/>
                        </Grid>

                        <!-- Divider -->
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8"/>

                        <!-- Total Net Payable -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Total Net Payable:" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="lblNetDifference" Text="Rs 0.00"
                                       HorizontalAlignment="Right" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </Grid>

                        <!-- Hint -->
                        <TextBlock x:Name="lblAdjustmentHint"
                                   Text="(Net Diff + Existing Due) includes prior balance"
                                   FontSize="10" FontStyle="Italic" HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,-2,0,10" Visibility="Collapsed"/>

                        <!-- Payment Action -->
                        <TextBlock Text="Payment Action" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,4"/>
                        <ComboBox x:Name="cmbPaymentAction" Style="{StaticResource ModernComboBox}"
                                  Height="36" Margin="0,0,0,10"
                                  SelectionChanged="CmbPaymentAction_SelectionChanged">
                            <ComboBoxItem Content="Amount Paid by Customer" IsSelected="True" Tag="CustomerPays"/>
                            <ComboBoxItem Content="Refund Issued to Customer" Tag="StoreRefunds"/>
                        </ComboBox>

                        <!-- Amount Received / Refunded -->
                        <TextBlock x:Name="lblPaymentAmount" Text="Amount Received" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtPaidByCustomer" Style="{StaticResource ModernTextBox}"
                                 Tag="Enter amount here..." Text="0"
                                 TextAlignment="Right" Padding="12,10"
                                 Margin="0,0,0,14" TextChanged="txtPaidByCustomer_TextChanged" PreviewTextInput="NumberValidation"/>

                        <!-- Process Button -->
                        <Button Content="Process Manual Refund"
                                Style="{StaticResource SuccessButton}"
                                Height="46" FontSize="14" Margin="0,4,0,0"
                                Click="ProcessRefund_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>



