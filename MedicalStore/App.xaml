<Application x:Class="MedicalStore.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <local:BalanceToColorConverter x:Key="BalanceToColorConverter" xmlns:local="clr-namespace:MedicalStore.Helpers"/>
            <converters:CurrencyConverter x:Key="CurrencyConverter" xmlns:converters="clr-namespace:MedicalStore.Converters"/>
            <converters:RawCurrencyConverter x:Key="RawCurrencyConverter" xmlns:converters="clr-namespace:MedicalStore.Converters"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
